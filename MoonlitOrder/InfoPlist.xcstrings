    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 친구들의 아이폰과 직접 연결해 보드게임을 함께 플레이하기 위해 로컬 네트워크 접근이 필요합니다."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k místní síti je potřeba, aby se šlo přímo propojit s iPhony kamarádů poblíž a hrát párty hry společně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalt netværk er nødvendig for at forbinde direkte til nærliggende venners iPhones og spille festspil sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf das lokale Netzwerk wird benötigt, um dich direkt mit den iPhones deiner Freunde in der Nähe zu verbinden und gemeinsam Partyspiele zu spielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεται πρόσβαση στο τοπικό δίκτυο για να συνδεθείς απευθείας με τα iPhone φίλων κοντά σου και να παίξετε μαζί παιχνίδια πάρτι."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local network access is needed to connect directly with the iPhones of friends nearby and play party games together."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local network access is needed to connect directly with the iPhones of friends nearby and play party games together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la red local para conectarte directamente con los iPhone de tus amigos cercanos y jugar juntos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallisverkon käyttö tarvitaan, jotta voit yhdistää suoraan lähellä olevien kavereiden iPhoneihin ja pelata bilepelejä yhdessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au réseau local est nécessaire pour se connecter directement aux iPhone de vos amis à proximité et jouer ensemble à des jeux de soirée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses jaringan lokal diperlukan untuk terhubung langsung dengan iPhone teman di dekatmu dan bermain game pesta bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla rete locale serve per collegarti direttamente agli iPhone degli amici vicini e giocare insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの友だちのiPhoneと直接つないでパーティゲームを一緒に遊ぶために、ローカルネットワークへのアクセスが必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til lokalt nettverk trengs for å koble direkte til vennenes iPhoner i nærheten og spille festspill sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot het lokale netwerk is nodig om rechtstreeks verbinding te maken met iPhones van vrienden in de buurt en samen feestspellen te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do sieci lokalnej jest potrzebny, aby łączyć się bezpośrednio z iPhone’ami znajomych w pobliżu i wspólnie grać w gry imprezowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à rede local é necessário para se conectar diretamente aos iPhones de amigos por perto e jogar juntos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен доступ к локальной сети, чтобы напрямую подключаться к iPhone друзей рядом и играть вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till lokalt nätverk behövs för att ansluta direkt till vännernas iPhones i närheten och spela festspel tillsammans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเข้าถึงเครือข่ายในพื้นที่เพื่อเชื่อมต่อกับ iPhone ของเพื่อนที่อยู่ใกล้โดยตรงและเล่นเกมปาร์ตี้ด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakındaki arkadaşlarının iPhone’larına doğrudan bağlanıp birlikte parti oyunları oynamak için yerel ağ erişimi gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền truy cập mạng cục bộ để kết nối trực tiếp với iPhone của bạn bè ở gần và cùng chơi trò chơi tiệc tùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问本地网络,才能直接连接附近朋友的iPhone,一起玩派对游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要訪問本地網路,才能直接連線附近朋友的iPhone,一起玩派對遊戲。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}

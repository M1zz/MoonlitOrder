    "달빛 결사가 원정 3회에 성공했습니다.\n하지만 암살자가 예언자를 찾아내면 그림자의 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달빛 결사가 원정 3회에 성공했습니다.\n하지만 암살자가 예언자를 찾아내면 그림자의 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Moonlit Order has succeeded at 3 missions.\nBut if the Assassin finds the Seer, the Shadows turn the tables!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Moonlit Order has succeeded at 3 missions.\nBut if the Assassin finds the Seer, the Shadows turn the tables!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月光結社が遠征ミッションを3回成功させました。\nただし暗殺者が予言者を見抜けば、影の逆転勝利です!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月光结社完成了3次远征任务。\n但如果刺客找出预言家,暗影就会逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月光結社完成了3次遠征任務。\n但如果刺客找出預言家,暗影就會逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лунный орден выполнил 3 похода.\nНо если убийца найдёт пророка, Тени победят в последний момент!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Orden Lunar logró 3 misiones.\n¡Pero si el Asesino encuentra al Vidente, las Sombras remontan!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mondorden hat 3 Missionen geschafft.\nFindet der Attentäter aber den Seher, drehen die Schatten das Spiel!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Ordre Lunaire a réussi 3 missions.\nMais si l’Assassin trouve l’Oracle, les Ombres renversent la partie !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Ordine Lunare ha compiuto 3 missioni.\nMa se l’Assassino trova il Veggente, le Ombre ribaltano la partita!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Ordem Lunar cumpriu 3 missões.\nMas se o Assassino encontrar o Vidente, as Sombras viram o jogo!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาคีแสงจันทร์ทำภารกิจสำเร็จ 3 ครั้ง\nแต่ถ้านักฆ่าหาผู้ทำนายเจอ ฝ่ายเงามืดจะพลิกชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hội Ánh Trăng đã hoàn thành 3 nhiệm vụ.\nNhưng nếu Sát Thủ tìm ra Nhà Tiên Tri, Bóng Tối sẽ lật ngược thế cờ!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíční řád zvládl 3 mise.\nPokud ale Vrah najde Věštce, Stíny otočí hru!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måneordenen har klaret 3 missioner.\nMen finder Snigmorderen Seeren, vender Skyggerne spillet!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Τάγμα της Σελήνης πέτυχε 3 αποστολές.\nΑν όμως ο Δολοφόνος βρει τον Μάντη, οι Σκιές ανατρέπουν το παιχνίδι!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuordo on onnistunut 3 tehtävässä.\nMutta jos Salamurhaaja löytää Näkijän, Varjot kääntävät pelin!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordo Cahaya Bulan menyelesaikan 3 misi.\nTetapi jika Pembunuh menemukan Peramal, Bayangan membalikkan keadaan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månordenen har klart 3 oppdrag.\nMen finner Snikmorderen Seeren, snur Skyggene spillet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Maanorde heeft 3 missies gehaald.\nMaar vindt de Moordenaar de Ziener, dan keren de Schaduwen het spel!"
          }
        }
      }
    },

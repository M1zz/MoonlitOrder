            "value" : "进入下一阶段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進入下一階段。"
          }
        }
      }
    },
    "암살 포기로 처리하고 달빛 결사의 승리로 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살 포기로 처리하고 달빛 결사의 승리로 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin is treated as having passed. The Moonlit Order wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin is treated as having passed. The Moonlit Order wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺を放棄したものとして扱い、月光結社の勝利で終わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为刺客放弃刺杀,月光结社获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為刺客放棄刺殺,月光結社獲勝。"
          }
        }
      }
    },
    "암살자가 예언자를 지목하지 못해 달빛 결사의 승리로 끝났습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자가 예언자를 지목하지 못해 달빛 결사의 승리로 끝났습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin did not name the Seer. The Moonlit Order wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin did not name the Seer. The Moonlit Order wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者が予言者を指名できず、月光結社の勝利で終わりました。"
          }
        },

        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løgneren regnes som å ha gitt opp å gjette. Borgerne vinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Leugenaar geldt als opgegeven met raden. De burgers winnen."
          }
        }
      }

    "다음" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次へ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一步"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一步"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguiente"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter"
          }
        }
      }
    },
    "각자 자신의 역할을 남몰래 확인하는 단계입니다. 역할을 확인한 뒤 '다음'을 누르면 봇들도 확인을 마칩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각자 자신의 역할을 남몰래 확인하는 단계입니다. 역할을 확인한 뒤 '다음'을 누르면 봇들도 확인을 마칩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this phase, everyone secretly checks their own role. After you check yours and tap 'Next', the bots will finish checking too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this phase, everyone secretly checks their own role. After you check yours and tap 'Next', the bots will finish checking too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれがこっそり自分の役職を確認する段階です。役職を確認して「次へ」を押すと、ボットも確認を終えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是每个人悄悄确认自己身份的阶段。确认身份后点“下一步”,机器人也会完成确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是每個人悄悄確認自己身分的階段。確認身分後點“下一步”,機器人也會完成確認。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом этапе каждый тайно смотрит свою роль. Посмотрите её и нажмите «Далее» — боты тоже закончат проверку."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta fase, cada quien mira su propio rol en secreto. Cuando lo hayas visto, pulsa «Siguiente» y los bots también terminarán."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Phase sieht jeder heimlich seine eigene Rolle an. Wenn du sie gesehen hast und auf „Weiter“ tippst, sind auch die Bots fertig."
          }
        }
      }
    },
    "리더가 이번 원정을 떠날 원정대를 지명합니다. '다음'을 누르면 리더가 팀을 고릅니다. (내가 리더라면 직접 골라보세요!)" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리더가 이번 원정을 떠날 원정대를 지명합니다. '다음'을 누르면 리더가 팀을 고릅니다. (내가 리더라면 직접 골라보세요!)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The leader picks the team for this mission. Tap 'Next' and the leader chooses a team. (If you are the leader, pick it yourself!)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The leader picks the team for this mission. Tap 'Next' and the leader chooses a team. (If you are the leader, pick it yourself!)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーが今回の遠征に向かう遠征隊を指名します。「次へ」を押すとリーダーがチームを選びます。(自分がリーダーなら、自分で選んでみましょう!)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队长提名这次出发的远征队。点“下一步”后队长会选择队员。(如果你是队长,请亲自选择!)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隊長提名這次出發的遠征隊。點“下一步”後隊長會選擇隊員。(如果你是隊長,請親自選擇!)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лидер выбирает отряд для этого похода. Нажмите «Далее», и лидер выберет команду. (Если лидер — вы, выбирайте сами!)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El líder propone el equipo para esta misión. Pulsa «Siguiente» y el líder elegirá el equipo. (Si eres el líder, ¡elígelo tú!)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anführer bestimmt das Team für diese Mission. Tippe auf „Weiter“, dann wählt der Anführer das Team. (Bist du der Anführer, wähle selbst!)"
          }
        }
      }
    },
    "전원이 원정대 구성에 찬성/반대를 투표합니다. 동수면 부결! 먼저 투표해보고 '다음'으로 봇들의 표를 확인하세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원이 원정대 구성에 찬성/반대를 투표합니다. 동수면 부결! 먼저 투표해보고 '다음'으로 봇들의 표를 확인하세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone votes to approve or reject the team. A tie means rejection! Vote first, then tap 'Next' to see the bots' votes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone votes to approve or reject the team. A tie means rejection! Vote first, then tap 'Next' to see the bots' votes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が遠征隊の編成に賛成か反対かを投票します。同数なら否決!先に投票してから、「次へ」でボットの票を確認しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人对远征队的组成投赞成/反对票。平票即否决!先投票,再点“下一步”查看机器人的票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人對遠征隊的組成投贊成/反對票。平票即否決!先投票,再點“下一步”檢視機器人的票。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все голосуют «за» или «против» состава отряда. При ничьей отряд отклоняется! Сначала проголосуйте, затем нажмите «Далее», чтобы увидеть голоса ботов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos votan a favor o en contra del equipo. ¡Si hay empate, se rechaza! Vota primero y pulsa «Siguiente» para ver los votos de los bots."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle stimmen über die Teamzusammenstellung ab (dafür/dagegen). Bei Gleichstand wird abgelehnt! Stimme zuerst ab und tippe dann auf „Weiter“, um die Stimmen der Bots zu sehen."
          }
        }
      }
    },
    "투표 결과입니다. 원정대가 5회 연속 부결되면 그림자 진영이 승리하니 무작정 반대만 할 수는 없어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투표 결과입니다. 원정대가 5회 연속 부결되면 그림자 진영이 승리하니 무작정 반대만 할 수는 없어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the vote results. If the team is rejected 5 times in a row, the Shadows win, so you cannot just reject everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the vote results. If the team is rejected 5 times in a row, the Shadows win, so you cannot just reject everything."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票結果です。遠征隊が5回連続で否決されると影陣営が勝つので、むやみに反対ばかりはできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是投票结果。远征队连续5次被否决,暗影阵营就会获胜,所以不能一味反对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是投票結果。遠征隊連續5次被否決,暗影陣營就會獲勝,所以不能一味反對。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты голосования. Если отряд отклонён 5 раз подряд, побеждают Тени, так что просто голосовать «против» нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los resultados de la votación. Si el equipo se rechaza 5 veces seguidas, ganan las Sombras, así que no basta con votar siempre en contra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das Abstimmungsergebnis. Wird das Team 5-mal in Folge abgelehnt, gewinnen die Schatten – du kannst also nicht einfach immer dagegen sein."
          }
        }
      }
    },
    "원정대원만 성공/실패 카드를 냅니다. 달빛 결사는 성공만 낼 수 있고, 그림자만 몰래 실패를 낼 수 있어요. '다음'으로 원정대의 카드 제출을 지켜보세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원정대원만 성공/실패 카드를 냅니다. 달빛 결사는 성공만 낼 수 있고, 그림자만 몰래 실패를 낼 수 있어요. '다음'으로 원정대의 카드 제출을 지켜보세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only team members play a success or fail card. The Moonlit Order can only play success; only the Shadows can secretly play fail. Tap 'Next' to watch the team submit cards."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only team members play a success or fail card. The Moonlit Order can only play success; only the Shadows can secretly play fail. Tap 'Next' to watch the team submit cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊員だけが成功か失敗のカードを出します。月光結社は成功しか出せず、影だけがこっそり失敗を出せます。「次へ」で遠征隊のカード提出を見守りましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有远征队员出成功/失败牌。月光结社只能出成功,只有暗影可以悄悄出失败。点“下一步”观看远征队提交牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有遠征隊員出成功/失敗牌。月光結社只能出成功,只有暗影可以悄悄出失敗。點“下一步”觀看遠征隊提交牌。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карты «успех» или «провал» играют только участники отряда. Лунный орден может сыграть только «успех», а «провал» тайно могут сыграть лишь Тени. Нажмите «Далее», чтобы увидеть, как отряд сдаёт карты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los miembros del equipo juegan una carta de éxito o fracaso. La Orden Lunar solo puede jugar éxito; únicamente las Sombras pueden jugar fracaso en secreto. Pulsa «Siguiente» para ver cómo el equipo entrega sus cartas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Teammitglieder spielen eine Erfolgs- oder Fehlschlagkarte. Der Mondorden kann nur Erfolg spielen, nur die Schatten können heimlich Fehlschlag spielen. Tippe auf „Weiter“, um die Kartenabgabe des Teams zu verfolgen."
          }
        }
      }
    },
    "실패 카드가 기준 수 이상이면 원정 실패! 어느 진영이든 먼저 3승을 가져가면 게임이 끝납니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실패 카드가 기준 수 이상이면 원정 실패! 어느 진영이든 먼저 3승을 가져가면 게임이 끝납니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the fail cards reach the required number, the mission fails! The first side to win 3 missions ends the game."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the fail cards reach the required number, the mission fails! The first side to win 3 missions ends the game."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗カードが基準枚数以上なら遠征は失敗!どちらの陣営でも先に3勝すればゲーム終了です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失败牌达到规定数量,远征就失败!任一阵营先拿下3胜,游戏结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗牌達到規定數量,遠征就失敗!任一陣營先拿下3勝,遊戲結束。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если карт «провал» не меньше нужного числа, поход провален! Игра заканчивается, когда одна из сторон наберёт 3 победы."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Si las cartas de fracaso alcanzan el mínimo, la misión fracasa! Quien logre 3 victorias primero termina la partida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreichen die Fehlschlagkarten die nötige Zahl, scheitert die Mission! Wer zuerst 3 Siege holt, beendet das Spiel."
          }
        }
      }
    },
    "미션 3회가 성공해도 마지막 반전이 남아 있습니다 — 암살자가 예언자를 정확히 지목하면 그림자가 역전승합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 3회가 성공해도 마지막 반전이 남아 있습니다 — 암살자가 예언자를 정확히 지목하면 그림자가 역전승합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if 3 missions succeed, there is a final twist: if the Assassin correctly names the Seer, the Shadows turn the tables."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if 3 missions succeed, there is a final twist: if the Assassin correctly names the Seer, the Shadows turn the tables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッションが3回成功しても、最後のどんでん返しが残っています — 暗殺者が予言者を正しく指名すれば、影が逆転勝利します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使任务成功3次,最后还有反转 — 刺客如果准确指认出预言家,暗影就会逆转获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使任務成功3次,最後還有反轉 — 刺客如果準確指認出預言家,暗影就會逆轉獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если выполнены 3 миссии, остаётся финальный поворот: если убийца точно укажет на пророка, Тени победят в последний момент."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque se logren 3 misiones, queda un giro final: si el Asesino señala con acierto al Vidente, las Sombras remontan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn 3 Missionen gelingen, gibt es noch eine letzte Wendung: Benennt der Attentäter den Seher richtig, drehen die Schatten das Spiel."
          }
        }
      }
    },
    "호스트와 연결이 끊겼습니다. 자동으로 재접속을 시도하는 중…" : {

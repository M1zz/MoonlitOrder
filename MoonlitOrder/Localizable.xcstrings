    "실패 카드가 나왔지만 이번 원정은 %lld장이 필요해 버텨냈습니다!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실패 카드가 나왔지만 이번 원정은 %lld장이 필요해 버텨냈습니다!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fail card was played, but this mission needed %lld, so it held!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fail card was played, but this mission needed %lld, so it held!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗カードが出ましたが、今回の遠征は%lld枚必要なので持ちこたえました!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出现了失败牌,但本次远征需要%lld张才算失败,所以撑住了!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出現了失敗牌,但本次遠征需要%lld張才算失敗,所以撐住了!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта «провал» выпала, но для провала этого похода нужно карт: %lld, так что он устоял!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salió una carta de fracaso, pero esta misión necesitaba %lld, ¡así que aguantó!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

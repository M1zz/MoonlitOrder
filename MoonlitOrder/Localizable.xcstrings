    "가장 의심스러운 사람에게 투표하세요 · 표가 갈리면 라이어의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 의심스러운 사람에게 투표하세요 · 표가 갈리면 라이어의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vote for the most suspicious player · If votes are split, the Liar wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vote for the most suspicious player · If votes are split, the Liar wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん怪しい人に投票してください ・ 票が割れたらライアーの勝ち!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给最可疑的人投票 · 票数分散则说谎者获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給最可疑的人投票 · 票數分散則說謊者獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосуйте за самого подозрительного · если голоса разделятся, победит лжец!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vota por la persona más sospechosa · ¡si los votos se dividen, gana el Mentiroso!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimme für die verdächtigste Person · Bei geteilten Stimmen gewinnt der Lügner!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votez pour la personne la plus suspecte · Si les voix se partagent, le Menteur gagne !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vota la persona più sospetta · Se i voti si dividono, vince il Bugiardo!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vote na pessoa mais suspeita · Se os votos se dividirem, o Mentiroso vence!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหวตให้คนที่น่าสงสัยที่สุด · ถ้าคะแนนแตก ไลเออร์ชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bỏ phiếu cho người đáng ngờ nhất · Nếu phiếu bị chia, Kẻ Nói Dối thắng!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlasuj pro nejpodezřelejšího · Když se hlasy rozdělí, vyhrává Lhář!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stem på den mest mistænkelige · Hvis stemmerne deles, vinder Løgneren!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ψήφισε τον πιο ύποπτο · Αν οι ψήφοι μοιραστούν, κερδίζει ο Ψεύτης!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänestä epäilyttävintä · Jos äänet jakautuvat, Valehtelija voittaa!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih yang paling mencurigakan · Jika suara terbagi, Si Pembohong menang!"

    },
    "아직 투표하지 않은 사람은 기권으로 처리하고 개표합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 투표하지 않은 사람은 기권으로 처리하고 개표합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who have not voted are counted as abstaining. Counting the votes now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who have not voted are counted as abstaining. Counting the votes now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ投票していない人は棄権として扱い、開票します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未投票的人按弃权处理,开始计票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未投票的人按棄權處理,開始計票。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не проголосовавшие считаются воздержавшимися. Подсчитываем голоса."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes no han votado cuentan como abstención. Se hace el recuento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer noch nicht abgestimmt hat, zählt als Enthaltung. Die Stimmen werden gezählt."
          }
        }
      }
    },
    "라이어의 추측 포기로 처리하고 시민의 승리로 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이어의 추측 포기로 처리하고 시민의 승리로 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Liar is treated as having given up guessing. The Citizens win."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Liar is treated as having given up guessing. The Citizens win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライアーが推測を放棄したものとして扱い、市民の勝利で終わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为说谎者放弃猜测,平民获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為說謊者放棄猜測,平民獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается, что лжец отказался от догадки. Побеждают горожане."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se da por hecho que el Mentiroso renunció a adivinar. Ganan los ciudadanos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lügner gilt als verzichtet. Die Bürger gewinnen."
          }
        }
      }
    },
    "라이어가 답하지 못했습니다. 시민의 승리!" : {

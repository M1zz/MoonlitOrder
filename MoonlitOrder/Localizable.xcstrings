          "stringUnit" : {
            "state" : "translated",
            "value" : "ก็อบลินถูกขับไล่ หมู่บ้านชนะ!"
          }
        }
      }
    },
    "도깨비는 모두 중앙에 있었고, 아무도 추방되지 않았습니다. 마을의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비는 모두 중앙에 있었고, 아무도 추방되지 않았습니다. 마을의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the Goblins were in the center, and nobody was banished. The Village wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the Goblins were in the centre, and nobody was banished. The Village wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼はすべて中央にいて、誰も追放されませんでした。村の勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪全都在中间的牌里,没有人被放逐。村庄获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪全都在中間的牌裡,沒有人被放逐。村莊獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все гоблины были в центре, и никого не изгнали. Деревня побеждает!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los Trasgos estaban en el centro y no expulsaron a nadie. ¡Gana el Pueblo!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Kobolde lagen in der Mitte und niemand wurde verbannt. Das Dorf gewinnt!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

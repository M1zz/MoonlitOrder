    "제시어를 모르지만 아는 척 설명해야 합니다. 들키지 마세요!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제시어를 모르지만 아는 척 설명해야 합니다. 들키지 마세요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't know the word, but you have to describe it as if you do. Don't get caught!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't know the word, but you have to describe it as if you do. Don't get caught!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お題を知らなくても、知っているふりで説明しなければなりません。ばれないように!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不知道题词,却要装作知道来描述。别被发现!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不知道題詞,卻要裝作知道來描述。別被發現!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не знаете слова, но должны объяснять его так, будто знаете. Не попадитесь!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conoces la palabra, pero tienes que describirla como si la conocieras. ¡Que no te descubran!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kennst das Wort nicht, musst es aber beschreiben, als würdest du es kennen. Lass dich nicht erwischen!"
          }
        }
      }
    },

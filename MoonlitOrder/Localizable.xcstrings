    "가장 의심스러운 사람에게 투표하세요 · 표가 갈리면 라이어의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 의심스러운 사람에게 투표하세요 · 표가 갈리면 라이어의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vote for the most suspicious player · If votes are split, the Liar wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vote for the most suspicious player · If votes are split, the Liar wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

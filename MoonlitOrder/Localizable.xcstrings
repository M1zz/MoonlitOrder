          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 misiones con éxito (pero pierdes si asesinan al Vidente)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 erfolgreiche Missionen (verloren, wenn der Seher ermordet wird)"
          }
        },
        "fr" : {

        }
      }
    },
    "제시어를 그림으로 표현하세요. 글자·숫자는 금지! 다 그렸으면 '다음'을 눌러 봇들의 추측을 지켜보세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제시어를 그림으로 표현하세요. 글자·숫자는 금지! 다 그렸으면 '다음'을 눌러 봇들의 추측을 지켜보세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw the word. No letters or numbers! When you're done, tap 'Next' to watch the bots guess."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw the word. No letters or numbers! When you're done, tap 'Next' to watch the bots guess."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お題を絵で表現してください。文字・数字は禁止!描き終えたら「次へ」を押して、ボットの推測を見守りましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请用画表达题词。禁止写字和数字!画完后点“下一步”,观看机器人的猜测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請用畫表達題詞。禁止寫字和數字!畫完後點“下一步”,觀看機器人的猜測。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изобразите слово рисунком. Буквы и цифры запрещены! Закончив, нажмите «Далее», чтобы увидеть догадки ботов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expresa la palabra con un dibujo. ¡Sin letras ni números! Cuando termines, pulsa «Siguiente» para ver las suposiciones de los bots."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle das Wort als Zeichnung dar. Keine Buchstaben oder Zahlen! Wenn du fertig bist, tippe auf „Weiter“, um die Tipps der Bots zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exprimez le mot par un dessin. Lettres et chiffres interdits ! Quand vous avez fini, touchez « Suivant » pour suivre les propositions des bots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esprimi la parola con un disegno. Vietati lettere e numeri! Quando hai finito, tocca «Avanti» per vedere i tentativi dei bot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expresse a palavra com um desenho. Sem letras nem números! Ao terminar, toque em «Próximo» para ver os palpites dos bots."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วาดคำให้เป็นภาพ ห้ามใช้ตัวอักษรหรือตัวเลข! เมื่อวาดเสร็จ กด “ถัดไป” เพื่อดูคำทายของบอต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy diễn tả từ khóa bằng tranh. Cấm chữ và số! Vẽ xong hãy nhấn “Tiếp” để xem bot đoán."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyjádři slovo kresbou. Písmena a číslice jsou zakázány! Až skončíš, klepni na „Další“ a sleduj tipy botů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udtryk ordet med en tegning. Ingen bogstaver eller tal! Når du er færdig, tryk „Næste“ for at se botsenes gæt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξέφρασε τη λέξη με σχέδιο. Απαγορεύονται γράμματα και αριθμοί! Όταν τελειώσεις, πάτα «Επόμενο» για να δεις τις εικασίες των bots."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaise sana piirtämällä. Ei kirjaimia eikä numeroita! Kun olet valmis, paina ”Seuraava” nähdäksesi bottien arvaukset."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungkapkan kata dengan gambar. Dilarang huruf dan angka! Setelah selesai, tekan “Berikutnya” untuk melihat tebakan bot."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uttrykk ordet med en tegning. Ingen bokstaver eller tall! Når du er ferdig, trykker du «Neste» for å se robotenes gjetninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk het woord uit met een tekening. Geen letters of cijfers! Tik als je klaar bent op ‘Volgende’ om de gokken van de bots te zien."
          }
        }
      }
    },
    "라운드 결과입니다. 빨리 맞힌 사람일수록 높은 점수, 화가는 맞힌 사람이 많을수록 점수를 얻어요. '다음'으로 최종 순위를 확인하세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라운드 결과입니다. 빨리 맞힌 사람일수록 높은 점수, 화가는 맞힌 사람이 많을수록 점수를 얻어요. '다음'으로 최종 순위를 확인하세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Round results. The faster you guess, the more points; the Artist earns more the more people guess. Tap 'Next' for the final standings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Round results. The faster you guess, the more points; the Artist earns more the more people guess. Tap 'Next' for the final standings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラウンドの結果です。早く当てた人ほど高得点、絵描きは当てた人が多いほど得点が入ります。「次へ」で最終順位を確認しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是本回合的结果。猜得越快得分越高,猜中的人越多画家得分越高。点“下一步”查看最终排名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是本回合的結果。猜得越快得分越高,猜中的人越多畫家得分越高。點“下一步”檢視最終排名。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты раунда. Чем быстрее угадал, тем больше очков; художник получает больше очков, чем больше людей угадало. Нажмите «Далее», чтобы увидеть итоговый рейтинг."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados de la ronda. Cuanto antes aciertes, más puntos; el Artista suma más cuantas más personas acierten. Pulsa «Siguiente» para ver la clasificación final."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rundenergebnis. Je schneller geraten, desto mehr Punkte; der Zeichner bekommt mehr Punkte, je mehr Leute raten. Tippe auf „Weiter“ für die Endwertung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résultats de la manche. Plus on devine vite, plus on marque de points ; le Dessinateur marque d’autant plus que de gens devinent. Touchez « Suivant » pour le classement final."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risultati del round. Più veloce indovini, più punti fai; il Disegnatore ne fa di più quante più persone indovinano. Tocca «Avanti» per la classifica finale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultado da rodada. Quanto mais rápido você acerta, mais pontos; o Artista ganha mais quanto mais gente acerta. Toque em «Próximo» para ver a classificação final."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผลของรอบนี้ ยิ่งทายเร็วยิ่งได้คะแนนสูง ผู้วาดได้คะแนนมากขึ้นเมื่อมีคนทายถูกมากขึ้น กด “ถัดไป” เพื่อดูอันดับสุดท้าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả vòng. Đoán càng nhanh càng được nhiều điểm; Họa sĩ càng được điểm khi càng nhiều người đoán đúng. Nhấn “Tiếp” để xem xếp hạng cuối."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výsledky kola. Čím rychleji uhodneš, tím víc bodů; Malíř získá víc bodů, čím víc lidí uhodne. Klepni na „Další“ a uvidíš konečné pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rundens resultat. Jo hurtigere du gætter, jo flere point; Tegneren får flere point, jo flere der gætter. Tryk „Næste“ for den endelige rangliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτελέσματα γύρου. Όσο πιο γρήγορα μαντέψεις, τόσο περισσότεροι πόντοι· ο Ζωγράφος παίρνει περισσότερους όσο περισσότεροι μαντεύουν. Πάτα «Επόμενο» για την τελική κατάταξη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kierroksen tulos. Mitä nopeammin arvaat, sitä enemmän pisteitä; Piirtäjä saa sitä enemmän, mitä useampi arvaa. Paina ”Seuraava” nähdäksesi lopputulokset."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil ronde. Makin cepat menebak, makin tinggi skor; Pelukis mendapat lebih banyak skor jika makin banyak yang menebak. Tekan “Berikutnya” untuk melihat peringkat akhir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultat for runden. Jo raskere du gjetter, jo flere poeng; Tegneren får flere poeng jo flere som gjetter. Trykk «Neste» for den endelige rangeringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rondeuitslag. Hoe sneller geraden, hoe meer punten; de Tekenaar krijgt meer punten naarmate meer mensen raden. Tik op ‘Volgende’ voor de eindstand."
          }
        }
      }
    },

        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请按顺序用一句话描述题词"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請按順序用一句話描述題詞"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По очереди объясните слово парой слов"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe la palabra con pocas palabras, por turnos"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe reihum das Wort in wenigen Worten"
          }
        }
      }
    },
    "너무 자세히 말하면 라이어에게 힌트가 되고,\n너무 애매하면 당신이 의심받아요!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 자세히 말하면 라이어에게 힌트가 되고,\n너무 애매하면 당신이 의심받아요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say too much and you help the Liar.\nSay too little and you look suspicious!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say too much and you help the Liar.\nSay too little and you look suspicious!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳しく言いすぎるとライアーのヒントになり、\nあいまいすぎるとあなたが疑われます!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说得太详细会给说谎者提示,\n说得太含糊又会被你怀疑!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說得太詳細會給說謊者提示,\n說得太含糊又會被你懷疑!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажете слишком подробно — подскажете лжецу,\nслишком расплывчато — заподозрят вас!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hablas demasiado, ayudas al Mentiroso;\nsi eres demasiado vago, sospecharán de ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagst du zu viel, hilfst du dem Lügner,\nsagst du zu wenig, wirst du verdächtigt!"
          }
        }
      }
    },

    "행동하지 않은 사람은 능력 사용 없이 밤을 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동하지 않은 사람은 능력 사용 없이 밤을 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who did not act end the night without using a power."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who did not act end the night without using a power."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動しなかった人は、能力を使わずに夜を終えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有行动的人不使用能力,直接结束夜晚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

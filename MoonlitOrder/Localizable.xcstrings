    "행동하지 않은 사람은 능력 사용 없이 밤을 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동하지 않은 사람은 능력 사용 없이 밤을 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who did not act end the night without using a power."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who did not act end the night without using a power."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動しなかった人は、能力を使わずに夜を終えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有行动的人不使用能力,直接结束夜晚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有行動的人不使用能力,直接結束夜晚。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, кто не действовал, заканчивает ночь, не применяя способность."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien no actuó termina la noche sin usar su poder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer nicht gehandelt hat, beendet die Nacht ohne Fähigkeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui qui n’a pas agi termine la nuit sans utiliser son pouvoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi non ha agito termina la notte senza usare il potere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem não agiu termina a noite sem usar o poder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ไม่ได้ทำอะไรจะจบคืนโดยไม่ใช้พลัง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người không hành động sẽ kết thúc đêm mà không dùng năng lực."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo nejednal, končí noc bez použití schopnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der ikke handlede, afslutter natten uden at bruge sin evne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος δεν έδρασε τελειώνει τη νύχτα χωρίς να χρησιμοποιήσει τη δύναμή του."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, joka ei toiminut, päättää yön käyttämättä kykyään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang tidak bertindak mengakhiri malam tanpa memakai kemampuan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som ikke handlet, avslutter natten uten å bruke evnen sin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie niets deed, eindigt de nacht zonder zijn kracht te gebruiken."
          }
        }
      }
    },

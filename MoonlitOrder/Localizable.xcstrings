    "암살 포기로 처리하고 달빛 결사의 승리로 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살 포기로 처리하고 달빛 결사의 승리로 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin is treated as having passed. The Moonlit Order wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin is treated as having passed. The Moonlit Order wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺を放棄したものとして扱い、月光結社の勝利で終わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为刺客放弃刺杀,月光结社获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為刺客放棄刺殺,月光結社獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

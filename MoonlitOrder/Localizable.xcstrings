          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se da por hecho que el Asesino renunció. La Orden Lunar gana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter gilt als verzichtet. Der Mondorden gewinnt."
          }
        }
      }
    },
    "암살자가 예언자를 지목하지 못해 달빛 결사의 승리로 끝났습니다." : {
      "localizations" : {
        "ko" : {

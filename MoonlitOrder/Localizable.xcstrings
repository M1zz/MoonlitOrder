    "진행이 막히면 여기서 게임을 계속 굴릴 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행이 막히면 여기서 게임을 계속 굴릴 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the game gets stuck, you can keep it going from here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the game gets stuck, you can keep it going from here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行が止まったら、ここからゲームを動かし続けられます。"

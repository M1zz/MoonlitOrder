    "같은 Wi-Fi나 블루투스 거리 안에서 서로를 찾아요.\n처음에 뜨는 '로컬 네트워크' 접근 요청은 꼭 허용해 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi나 블루투스 거리 안에서 서로를 찾아요.\n처음에 뜨는 '로컬 네트워크' 접근 요청은 꼭 허용해 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You find each other over the same Wi-Fi or within Bluetooth range.\nBe sure to allow the 'Local Network' access request that appears at first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You find each other over the same Wi-Fi or within Bluetooth range.\nBe sure to allow the 'Local Network' access request that appears at first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じWi-Fiやブルートゥースの届く範囲で、お互いを見つけます。\n最初に表示される「ローカルネットワーク」へのアクセス要求は、必ず許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一Wi-Fi或蓝牙范围内互相查找。\n首次出现的“本地网络”访问请求,请务必允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一Wi-Fi或藍芽範圍內互相查詢。\n首次出現的“本地網路”訪問請求,請務必允許。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы найдёте друг друга в одной сети Wi-Fi или в зоне Bluetooth.\nОбязательно разрешите запрос доступа к «Локальной сети», который появится при первом запуске."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encuentran entre sí en la misma red Wi-Fi o dentro del alcance de Bluetooth.\nAsegúrate de permitir la solicitud de acceso a la «Red local» que aparece la primera vez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr findet euch im selben WLAN oder in Bluetooth-Reichweite.\nErlaube unbedingt die Anfrage zum Zugriff auf das „lokale Netzwerk“, die zu Beginn erscheint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous trouvez sur le même Wi-Fi ou à portée Bluetooth.\nAutorisez impérativement la demande d’accès au « réseau local » qui s’affiche au début."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi trovate sulla stessa rete Wi-Fi o nel raggio del Bluetooth.\nConsenti assolutamente la richiesta di accesso alla «Rete locale» che compare all’inizio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocês se encontram na mesma rede Wi-Fi ou ao alcance do Bluetooth.\nPermita sem falta o pedido de acesso à «Rede local» que aparece no início."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พวกคุณหากันเจอใน Wi-Fi เดียวกันหรือในระยะบลูทูธ\nโปรดอนุญาตคำขอเข้าถึง “เครือข่ายในพื้นที่” ที่ปรากฏตอนแรก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người tìm thấy nhau trong cùng Wi-Fi hoặc trong tầm Bluetooth.\nNhớ cho phép yêu cầu truy cập “Mạng cục bộ” xuất hiện lần đầu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najdete se v jedné síti Wi-Fi nebo v dosahu Bluetooth.\nPři prvním spuštění určitě povol žádost o přístup k „Místní síti“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I finder hinanden på samme Wi-Fi eller inden for Bluetooth-rækkevidde.\nHusk at tillade anmodningen om adgang til „Lokalt netværk“, der vises første gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκετε ο ένας τον άλλον στο ίδιο Wi-Fi ή εντός εμβέλειας Bluetooth.\nΦρόντισε να επιτρέψεις το αίτημα πρόσβασης στο «Τοπικό δίκτυο» που εμφανίζεται στην αρχή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydätte toisenne samassa Wi-Fi-verkossa tai Bluetoothin kantamalla.\nSalli ehdottomasti alussa näkyvä ”Paikallinen verkko” -käyttöpyyntö."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalian saling menemukan dalam Wi-Fi yang sama atau dalam jangkauan Bluetooth.\nPastikan mengizinkan permintaan akses “Jaringan Lokal” yang muncul di awal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere finner hverandre på samme Wi-Fi eller innen Bluetooth-rekkevidde.\nHusk å tillate forespørselen om tilgang til «Lokalt nettverk» som vises første gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jullie vinden elkaar op hetzelfde wifi-netwerk of binnen Bluetooth-bereik.\nSta het verzoek om toegang tot het ‘Lokale netwerk’ dat eerst verschijnt zeker toe."
          }
        }
      }
    },

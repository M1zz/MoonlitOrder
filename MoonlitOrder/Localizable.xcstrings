          }
        }
      }
    },
    "호스트에 다시 연결하지 못했습니다. 홈의 '이어서 하기'로 다시 참가할 수 있습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에 다시 연결하지 못했습니다. 홈의 '이어서 하기'로 다시 참가할 수 있습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reconnect to the host. You can rejoin from 'Resume' on the home screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reconnect to the host. You can rejoin from 'Resume' on the home screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストに再接続できませんでした。ホームの「続きから」から再び参加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重新连接到房主。你可以在主页的“继续游戏”中重新加入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法重新連線到房主。你可以在主畫面的“繼續遊戲”中重新加入。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переподключиться к хосту. Вы можете войти снова через «Продолжить» на главном экране."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a conectar con el anfitrión. Puedes volver a entrar desde «Continuar» en la pantalla de inicio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Host konnte nicht wiederhergestellt werden. Über „Fortsetzen“ auf dem Startbildschirm kannst du wieder beitreten."
          }
        }
      }
    },
    "모든 플레이어는 달빛 결사(선) 또는 그림자(악) 진영에 몰래 배정됩니다. 원정 미션을 최대 5번 진행하는 동안, 대화와 투표 기록만으로 누가 그림자인지 추리해야 합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 플레이어는 달빛 결사(선) 또는 그림자(악) 진영에 몰래 배정됩니다. 원정 미션을 최대 5번 진행하는 동안, 대화와 투표 기록만으로 누가 그림자인지 추리해야 합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every player is secretly assigned to the Moonlit Order (good) or the Shadows (evil). Over up to 5 missions, you must work out who the Shadows are from the conversation and voting record alone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every player is secretly assigned to the Moonlit Order (good) or the Shadows (evil). Over up to 5 missions, you must work out who the Shadows are from the conversation and voting record alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプレイヤーは、月光結社(善)または影(悪)の陣営にこっそり割り当てられます。最大5回の遠征ミッションの間、会話と投票の記録だけをもとに誰が影かを推理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有玩家都会被秘密分配到月光结社(善)或暗影(恶)阵营。在最多5次远征任务中,你只能凭对话和投票记录推理出谁是暗影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有玩家都會被秘密分配到月光結社(善)或暗影(惡)陣營。在最多5次遠征任務中,你只能憑對話和投票記錄推理出誰是暗影。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый игрок тайно получает сторону: Лунный орден (добро) или Тени (зло). За максимум 5 походов вам нужно вычислить, кто Тени, только по разговорам и записям голосований."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada jugador es asignado en secreto a la Orden Lunar (buenos) o a las Sombras (malos). En un máximo de 5 misiones, debes deducir quiénes son las Sombras solo con la conversación y el registro de votos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Spieler werden heimlich dem Mondorden (gut) oder den Schatten (böse) zugeteilt. Während bis zu 5 Missionen musst du allein anhand von Gesprächen und Abstimmungsverlauf herausfinden, wer die Schatten sind."
          }
        }
      }
    },
    "라이어 한 명만 빼고 전원이 같은 제시어를 받습니다. 돌아가며 제시어를 한 마디씩 설명하며 서로가 진짜인지 확인하세요. 라이어는 제시어를 모른 채 아는 척 연기해야 합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이어 한 명만 빼고 전원이 같은 제시어를 받습니다. 돌아가며 제시어를 한 마디씩 설명하며 서로가 진짜인지 확인하세요. 라이어는 제시어를 모른 채 아는 척 연기해야 합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone except one Liar receives the same secret word. Take turns describing the word in a few words and check who is the real deal. The Liar has to bluff without knowing the word."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone except one Liar receives the same secret word. Take turns describing the word in a few words and check who is the real deal. The Liar has to bluff without knowing the word."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライアー1人を除いて全員が同じお題を受け取ります。順番にお題をひと言ずつ説明して、互いに本物かどうか確かめましょう。ライアーはお題を知らないまま、知っているふりをしなければなりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了一名说谎者,所有人都会拿到同一个题词。轮流用一句话描述题词,确认彼此是否真的知道。说谎者不知道题词,必须装作知道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了一名說謊者,所有人都會拿到同一個題詞。輪流用一句話描述題詞,確認彼此是否真的知道。說謊者不知道題詞,必須裝作知道。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, кроме одного лжеца, получают одно и то же слово. По очереди объясняйте слово парой слов и проверяйте, кто настоящий. Лжец не знает слова и должен делать вид, что знает."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos reciben la misma palabra secreta, menos un Mentiroso. Por turnos, describan la palabra con pocas palabras y comprueben quién la conoce de verdad. El Mentiroso debe fingir sin saberla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle außer einem Lügner erhalten dasselbe Wort. Beschreibt reihum das Wort in wenigen Worten und prüft, wer es wirklich kennt. Der Lügner muss bluffen, ohne das Wort zu kennen."
          }
        }
      }
    },
    "마을에 도깨비가 숨어들었습니다! 밤에 각자 비밀 행동으로 정보를 얻거나 카드를 몰래 뒤바꾸고, 낮에 토론한 뒤 단 한 번의 투표로 추방할 사람을 정합니다. 밤사이 카드가 바뀔 수 있어 승패는 '최종 카드' 기준입니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마을에 도깨비가 숨어들었습니다! 밤에 각자 비밀 행동으로 정보를 얻거나 카드를 몰래 뒤바꾸고, 낮에 토론한 뒤 단 한 번의 투표로 추방할 사람을 정합니다. 밤사이 카드가 바뀔 수 있어 승패는 '최종 카드' 기준입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goblins have slipped into the village! At night, everyone uses a secret action to gather information or secretly swap cards. By day you discuss, then a single vote decides who is banished. Cards can change overnight, so the result is judged by the 'final card'."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goblins have slipped into the village! At night, everyone uses a secret action to gather information or secretly swap cards. By day you discuss, then a single vote decides who is banished. Cards can change overnight, so the result is judged by the 'final card'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "村に鬼が忍び込みました!夜はそれぞれ秘密の行動で情報を得たり、カードをこっそり入れ替えたりし、昼は議論したあと、たった一度の投票で追放する人を決めます。夜のあいだにカードが入れ替わることがあるので、勝敗は「最終カード」で決まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪潜入了村庄!夜里每个人通过秘密行动获取信息或悄悄换牌,白天讨论后,只用一次投票决定放逐谁。夜里牌可能被换掉,所以胜负以“最终的牌”为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪潛入了村莊!夜裡每個人透過秘密行動獲取資訊或悄悄換牌,白天討論後,只用一次投票決定放逐誰。夜裡牌可能被換掉,所以勝負以“最終的牌”為準。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В деревню проникли гоблины! Ночью каждый тайным действием узнаёт информацию или незаметно меняет карты, а днём все обсуждают и одним голосованием решают, кого изгнать. За ночь карты могут поменяться, поэтому итог определяется «финальной картой»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Los Trasgos se han colado en el pueblo! De noche, cada quien usa una acción secreta para obtener información o intercambiar cartas a escondidas; de día se debate y una sola votación decide a quién expulsar. Las cartas pueden cambiar durante la noche, así que el resultado se juzga por la «carta final»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kobolde haben sich ins Dorf geschlichen! Nachts gewinnt jeder durch eine geheime Aktion Informationen oder tauscht heimlich Karten, tagsüber wird diskutiert und eine einzige Abstimmung entscheidet, wer verbannt wird. Karten können sich über Nacht ändern, deshalb zählt die „letzte Karte“."
          }
        }
      }
    },
    "매 라운드 한 명이 '화가'가 되어 제시어를 그림으로만 표현합니다. 나머지는 그림을 보고 채팅으로 정답을 맞혀요. 글자나 숫자는 쓸 수 없습니다. 모든 참가자가 한 번씩 화가를 맡으면 게임이 끝납니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매 라운드 한 명이 '화가'가 되어 제시어를 그림으로만 표현합니다. 나머지는 그림을 보고 채팅으로 정답을 맞혀요. 글자나 숫자는 쓸 수 없습니다. 모든 참가자가 한 번씩 화가를 맡으면 게임이 끝납니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each round, one player becomes the 'Artist' and expresses the secret word only through a drawing. Everyone else watches the drawing and guesses in chat. No letters or numbers allowed. The game ends once every player has been the Artist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each round, one player becomes the 'Artist' and expresses the secret word only through a drawing. Everyone else watches the drawing and guesses in chat. No letters or numbers allowed. The game ends once every player has been the Artist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎ラウンド1人が「絵描き」になり、お題を絵だけで表現します。ほかの人は絵を見て、チャットで答えを当てます。文字や数字は使えません。全員が一度ずつ絵描きを務めるとゲーム終了です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每回合有一名玩家成为“画家”,只能用画画表达题词。其他人看画,在聊天中猜答案。不能写字或数字。每位玩家都当过一次画家后,游戏结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每回合有一名玩家成為“畫家”,只能用畫畫表達題詞。其他人看畫,在聊天中猜答案。不能寫字或數字。每位玩家都當過一次畫家後,遊戲結束。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждом раунде один игрок становится «художником» и показывает слово только рисунком. Остальные смотрят на рисунок и угадывают ответ в чате. Нельзя использовать буквы и цифры. Игра заканчивается, когда каждый побывает художником."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada ronda, un jugador es el «Artista» y expresa la palabra secreta solo con un dibujo. Los demás miran el dibujo y adivinan en el chat. No se permiten letras ni números. El juego termina cuando todos hayan sido el Artista."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In jeder Runde wird ein Spieler zum „Zeichner“ und stellt das Wort nur durch eine Zeichnung dar. Die anderen sehen zu und raten im Chat. Buchstaben und Zahlen sind verboten. Das Spiel endet, wenn jeder einmal Zeichner war."
          }
        }
      }
    },

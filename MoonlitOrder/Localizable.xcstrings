            "value" : "ไลเออร์ทายคำไม่ถูก ฝ่ายพลเมืองชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kẻ Nói Dối không đoán được từ khóa. Phe công dân thắng!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lhář slovo neuhodl. Občané vyhrávají!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løgneren gættede ikke ordet. Borgerne vinder!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Ψεύτης δεν μάντεψε τη λέξη. Οι Πολίτες κερδίζουν!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valehtelija ei arvannut sanaa. Kansalaiset voittavat!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Pembohong tidak menebak kata. Warga menang!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løgneren gjettet ikke ordet. Borgerne vinner!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Leugenaar raadde het woord niet. De burgers winnen!"
          }
        }
      }
    },

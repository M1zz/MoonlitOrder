        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ván đang chơi sẽ tiếp tục với những người còn lại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozehraná hra pokračuje s ostatními hráči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et igangværende spil fortsætter med de resterende spillere."

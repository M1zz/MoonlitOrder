        }
      }
    },
    "전원이 원정대 구성에 찬성/반대를 투표합니다. 동수면 부결! 먼저 투표해보고 '다음'으로 봇들의 표를 확인하세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원이 원정대 구성에 찬성/반대를 투표합니다. 동수면 부결! 먼저 투표해보고 '다음'으로 봇들의 표를 확인하세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone votes to approve or reject the team. A tie means rejection! Vote first, then tap 'Next' to see the bots' votes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone votes to approve or reject the team. A tie means rejection! Vote first, then tap 'Next' to see the bots' votes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が遠征隊の編成に賛成か反対かを投票します。同数なら否決!先に投票してから、「次へ」でボットの票を確認しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人对远征队的组成投赞成/反对票。平票即否决!先投票,再点“下一步”查看机器人的票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人對遠征隊的組成投贊成/反對票。平票即否決!先投票,再點“下一步”檢視機器人的票。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все голосуют «за» или «против» состава отряда. При ничьей отряд отклоняется! Сначала проголосуйте, затем нажмите «Далее», чтобы увидеть голоса ботов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos votan a favor o en contra del equipo. ¡Si hay empate, se rechaza! Vota primero y pulsa «Siguiente» para ver los votos de los bots."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle stimmen über die Teamzusammenstellung ab (dafür/dagegen). Bei Gleichstand wird abgelehnt! Stimme zuerst ab und tippe dann auf „Weiter“, um die Stimmen der Bots zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde vote pour ou contre la composition de l’équipe. En cas d’égalité, elle est rejetée ! Votez d’abord, puis touchez « Suivant » pour voir les votes des bots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti votano a favore o contro la composizione del gruppo. In caso di parità viene respinto! Vota prima, poi tocca «Avanti» per vedere i voti dei bot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos votam a favor ou contra a formação da equipe. Em caso de empate, é rejeitada! Vote primeiro e toque em «Próximo» para ver os votos dos bots."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนโหวตเห็นด้วยหรือไม่เห็นด้วยกับทีม ถ้าคะแนนเท่ากันถือว่าไม่ผ่าน! โหวตก่อน แล้วกด “ถัดไป” เพื่อดูคะแนนของบอต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người bỏ phiếu đồng ý hoặc phản đối đội hình. Hòa phiếu là bị từ chối! Hãy bỏ phiếu trước rồi nhấn “Tiếp” để xem phiếu của bot."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všichni hlasují pro nebo proti složení týmu. Při shodě hlasů je tým zamítnut! Nejdřív hlasuj a pak klepni na „Další“, abys viděl hlasy botů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle stemmer for eller imod holdets sammensætning. Står det lige, afvises det! Stem først, og tryk så „Næste“ for at se botsenes stemmer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι ψηφίζουν υπέρ ή κατά της σύνθεσης της ομάδας. Σε ισοπαλία απορρίπτεται! Ψήφισε πρώτα και πάτα «Επόμενο» για να δεις τις ψήφους των bots."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki äänestävät ryhmän kokoonpanoa puolesta tai vastaan. Tasatilanteessa ryhmä hylätään! Äänestä ensin ja paina sitten ”Seuraava” nähdäksesi bottien äänet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang memilih setuju atau tidak setuju pada susunan tim. Jika seri, tim ditolak! Pilih dulu, lalu tekan “Berikutnya” untuk melihat suara bot."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle stemmer for eller imot lagets sammensetning. Står det likt, avvises det! Stem først, og trykk så «Neste» for å se robotenes stemmer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen stemt voor of tegen de teamsamenstelling. Bij gelijkspel wordt het afgewezen! Stem eerst en tik dan op ‘Volgende’ om de stemmen van de bots te zien."
          }
        }
      }
    },
    "투표 결과입니다. 원정대가 5회 연속 부결되면 그림자 진영이 승리하니 무작정 반대만 할 수는 없어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투표 결과입니다. 원정대가 5회 연속 부결되면 그림자 진영이 승리하니 무작정 반대만 할 수는 없어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the vote results. If the team is rejected 5 times in a row, the Shadows win, so you cannot just reject everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the vote results. If the team is rejected 5 times in a row, the Shadows win, so you cannot just reject everything."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票結果です。遠征隊が5回連続で否決されると影陣営が勝つので、むやみに反対ばかりはできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是投票结果。远征队连续5次被否决,暗影阵营就会获胜,所以不能一味反对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是投票結果。遠征隊連續5次被否決,暗影陣營就會獲勝,所以不能一味反對。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты голосования. Если отряд отклонён 5 раз подряд, побеждают Тени, так что просто голосовать «против» нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los resultados de la votación. Si el equipo se rechaza 5 veces seguidas, ganan las Sombras, así que no basta con votar siempre en contra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das Abstimmungsergebnis. Wird das Team 5-mal in Folge abgelehnt, gewinnen die Schatten – du kannst also nicht einfach immer dagegen sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les résultats du vote. Si l’équipe est rejetée 5 fois de suite, les Ombres gagnent : on ne peut donc pas voter contre systématiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecco il risultato della votazione. Se il gruppo viene respinto 5 volte di fila, vincono le Ombre: non puoi semplicemente votare sempre contro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o resultado da votação. Se a equipe for rejeitada 5 vezes seguidas, as Sombras vencem — então não dá para votar sempre contra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือผลโหวต ถ้าทีมถูกปฏิเสธติดกัน 5 ครั้ง ฝ่ายเงามืดจะชนะ จึงโหวตคัดค้านอย่างเดียวไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là kết quả bỏ phiếu. Nếu đội bị từ chối 5 lần liên tiếp, phe Bóng Tối thắng nên không thể cứ phản đối bừa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je výsledek hlasování. Pokud je tým 5× po sobě zamítnut, vyhrávají Stíny, takže nelze jen slepě hlasovat proti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her er afstemningens resultat. Afvises holdet 5 gange i træk, vinder Skyggerne, så du kan ikke bare stemme imod hele tiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά είναι τα αποτελέσματα της ψηφοφορίας. Αν η ομάδα απορριφθεί 5 φορές στη σειρά, κερδίζουν οι Σκιές, οπότε δεν μπορείς απλώς να ψηφίζεις πάντα κατά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä äänestyksen tulos. Jos ryhmä hylätään 5 kertaa peräkkäin, Varjot voittavat, joten et voi vain äänestää aina vastaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini hasil pemungutan suara. Jika tim ditolak 5 kali berturut-turut, Bayangan menang, jadi tidak bisa asal menolak terus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er resultatet av avstemningen. Avvises laget 5 ganger på rad, vinner Skyggene, så du kan ikke bare stemme imot hele tiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is de stemuitslag. Wordt het team 5 keer achter elkaar afgewezen, dan winnen de Schaduwen, dus je kunt niet gewoon altijd tegen stemmen."
          }
        }
      }
    },
    "원정대원만 성공/실패 카드를 냅니다. 달빛 결사는 성공만 낼 수 있고, 그림자만 몰래 실패를 낼 수 있어요. '다음'으로 원정대의 카드 제출을 지켜보세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원정대원만 성공/실패 카드를 냅니다. 달빛 결사는 성공만 낼 수 있고, 그림자만 몰래 실패를 낼 수 있어요. '다음'으로 원정대의 카드 제출을 지켜보세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only team members play a success or fail card. The Moonlit Order can only play success; only the Shadows can secretly play fail. Tap 'Next' to watch the team submit cards."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only team members play a success or fail card. The Moonlit Order can only play success; only the Shadows can secretly play fail. Tap 'Next' to watch the team submit cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊員だけが成功か失敗のカードを出します。月光結社は成功しか出せず、影だけがこっそり失敗を出せます。「次へ」で遠征隊のカード提出を見守りましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有远征队员出成功/失败牌。月光结社只能出成功,只有暗影可以悄悄出失败。点“下一步”观看远征队提交牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有遠征隊員出成功/失敗牌。月光結社只能出成功,只有暗影可以悄悄出失敗。點“下一步”觀看遠征隊提交牌。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карты «успех» или «провал» играют только участники отряда. Лунный орден может сыграть только «успех», а «провал» тайно могут сыграть лишь Тени. Нажмите «Далее», чтобы увидеть, как отряд сдаёт карты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los miembros del equipo juegan una carta de éxito o fracaso. La Orden Lunar solo puede jugar éxito; únicamente las Sombras pueden jugar fracaso en secreto. Pulsa «Siguiente» para ver cómo el equipo entrega sus cartas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Teammitglieder spielen eine Erfolgs- oder Fehlschlagkarte. Der Mondorden kann nur Erfolg spielen, nur die Schatten können heimlich Fehlschlag spielen. Tippe auf „Weiter“, um die Kartenabgabe des Teams zu verfolgen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les membres de l’équipe jouent une carte succès ou échec. L’Ordre Lunaire ne peut jouer que succès ; seules les Ombres peuvent jouer échec en secret. Touchez « Suivant » pour suivre la remise des cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i membri del gruppo giocano una carta successo o fallimento. L’Ordine Lunare può giocare solo successo; solo le Ombre possono giocare fallimento di nascosto. Tocca «Avanti» per vedere la consegna delle carte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os membros da equipe jogam uma carta de sucesso ou fracasso. A Ordem Lunar só pode jogar sucesso; apenas as Sombras podem jogar fracasso em segredo. Toque em «Próximo» para acompanhar a entrega das cartas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะสมาชิกทีมที่ส่งการ์ดสำเร็จหรือล้มเหลว ภาคีแสงจันทร์ส่งได้แค่สำเร็จ มีแต่เงามืดที่แอบส่งล้มเหลวได้ กด “ถัดไป” เพื่อดูทีมส่งการ์ด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ thành viên đội ra bài thành công hoặc thất bại. Hội Ánh Trăng chỉ ra được thành công; chỉ Bóng Tối mới có thể lén ra thất bại. Nhấn “Tiếp” để xem đội nộp bài."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu úspěchu nebo neúspěchu hrají jen členové týmu. Měsíční řád může zahrát jen úspěch; neúspěch mohou tajně zahrát jen Stíny. Klepni na „Další“ a sleduj odevzdávání karet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun holdmedlemmer spiller et succes- eller fiaskokort. Måneordenen kan kun spille succes; kun Skyggerne kan i hemmelighed spille fiasko. Tryk „Næste“ for at følge holdets kortaflevering."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο τα μέλη της ομάδας παίζουν κάρτα επιτυχίας ή αποτυχίας. Το Τάγμα της Σελήνης παίζει μόνο επιτυχία· μόνο οι Σκιές μπορούν να παίξουν κρυφά αποτυχία. Πάτα «Επόμενο» για να δεις την κατάθεση καρτών."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain ryhmän jäsenet pelaavat onnistumis- tai epäonnistumiskortin. Kuuordo voi pelata vain onnistumisen; vain Varjot voivat salaa pelata epäonnistumisen. Paina ”Seuraava” seurataksesi korttien jättämistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya anggota tim yang memainkan kartu sukses atau gagal. Ordo Cahaya Bulan hanya bisa memainkan sukses; hanya Bayangan yang bisa diam-diam memainkan gagal. Tekan “Berikutnya” untuk melihat tim menyerahkan kartu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lagmedlemmer spiller et suksess- eller fiaskokort. Månordenen kan bare spille suksess; bare Skyggene kan i hemmelighet spille fiasko. Trykk «Neste» for å følge lagets kortinnlevering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen teamleden spelen een succes- of mislukkingskaart. De Maanorde kan alleen succes spelen; alleen de Schaduwen kunnen stiekem mislukking spelen. Tik op ‘Volgende’ om het inleveren van de kaarten te volgen."
          }
        }
      }
    },
    "실패 카드가 기준 수 이상이면 원정 실패! 어느 진영이든 먼저 3승을 가져가면 게임이 끝납니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실패 카드가 기준 수 이상이면 원정 실패! 어느 진영이든 먼저 3승을 가져가면 게임이 끝납니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the fail cards reach the required number, the mission fails! The first side to win 3 missions ends the game."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the fail cards reach the required number, the mission fails! The first side to win 3 missions ends the game."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗カードが基準枚数以上なら遠征は失敗!どちらの陣営でも先に3勝すればゲーム終了です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失败牌达到规定数量,远征就失败!任一阵营先拿下3胜,游戏结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗牌達到規定數量,遠征就失敗!任一陣營先拿下3勝,遊戲結束。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если карт «провал» не меньше нужного числа, поход провален! Игра заканчивается, когда одна из сторон наберёт 3 победы."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Si las cartas de fracaso alcanzan el mínimo, la misión fracasa! Quien logre 3 victorias primero termina la partida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreichen die Fehlschlagkarten die nötige Zahl, scheitert die Mission! Wer zuerst 3 Siege holt, beendet das Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les cartes échec atteignent le nombre requis, la mission échoue ! Le premier camp à 3 victoires met fin à la partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se le carte fallimento raggiungono il numero richiesto, la missione fallisce! Chi per primo ottiene 3 vittorie chiude la partita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se as cartas de fracasso atingirem o número exigido, a missão falha! Quem fizer 3 vitórias primeiro encerra o jogo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าการ์ดล้มเหลวถึงจำนวนที่กำหนด ภารกิจล้มเหลว! ฝ่ายไหนชนะครบ 3 ก่อน เกมจบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu số bài thất bại đạt mức yêu cầu thì nhiệm vụ thất bại! Phe nào thắng 3 trận trước thì ván kết thúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud karet neúspěchu dosáhne požadovaného počtu, mise selže! Kdo první získá 3 vítězství, ukončí hru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fiaskokortene når det krævede antal, mislykkes missionen! Den, der først får 3 sejre, afslutter spillet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν οι κάρτες αποτυχίας φτάσουν τον απαιτούμενο αριθμό, η αποστολή αποτυγχάνει! Όποιος πάρει πρώτος 3 νίκες τελειώνει το παιχνίδι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos epäonnistumiskorttien määrä yltää vaadittuun, tehtävä epäonnistuu! Se, joka ensin saa 3 voittoa, päättää pelin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kartu gagal mencapai jumlah yang dibutuhkan, misi gagal! Pihak yang lebih dulu meraih 3 kemenangan mengakhiri permainan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fiaskokortene når det nødvendige antallet, mislykkes oppdraget! Den som først får 3 seire, avslutter spillet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereiken de mislukkingskaarten het vereiste aantal, dan mislukt de missie! Wie als eerste 3 overwinningen haalt, beëindigt het spel."
          }
        }
      }
    },
    "미션 3회가 성공해도 마지막 반전이 남아 있습니다 — 암살자가 예언자를 정확히 지목하면 그림자가 역전승합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 3회가 성공해도 마지막 반전이 남아 있습니다 — 암살자가 예언자를 정확히 지목하면 그림자가 역전승합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if 3 missions succeed, there is a final twist: if the Assassin correctly names the Seer, the Shadows turn the tables."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if 3 missions succeed, there is a final twist: if the Assassin correctly names the Seer, the Shadows turn the tables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッションが3回成功しても、最後のどんでん返しが残っています — 暗殺者が予言者を正しく指名すれば、影が逆転勝利します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使任务成功3次,最后还有反转 — 刺客如果准确指认出预言家,暗影就会逆转获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使任務成功3次,最後還有反轉 — 刺客如果準確指認出預言家,暗影就會逆轉獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если выполнены 3 миссии, остаётся финальный поворот: если убийца точно укажет на пророка, Тени победят в последний момент."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque se logren 3 misiones, queda un giro final: si el Asesino señala con acierto al Vidente, las Sombras remontan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn 3 Missionen gelingen, gibt es noch eine letzte Wendung: Benennt der Attentäter den Seher richtig, drehen die Schatten das Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même si 3 missions réussissent, un dernier rebondissement reste possible : si l’Assassin désigne correctement l’Oracle, les Ombres renversent la partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche se riescono 3 missioni, resta un ultimo colpo di scena: se l’Assassino indica correttamente il Veggente, le Ombre ribaltano la partita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com 3 missões cumpridas, ainda há uma virada final: se o Assassino apontar corretamente o Vidente, as Sombras viram o jogo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ภารกิจสำเร็จ 3 ครั้ง ก็ยังมีจุดพลิกสุดท้าย — ถ้านักฆ่าชี้ตัวผู้ทำนายถูก ฝ่ายเงามืดจะพลิกชนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù 3 nhiệm vụ thành công vẫn còn cú lật cuối: nếu Sát Thủ chỉ đúng Nhà Tiên Tri, Bóng Tối sẽ lật ngược thế cờ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I když uspějí 3 mise, zbývá poslední zvrat: pokud Vrah správně určí Věštce, Stíny otočí hru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv hvis 3 missioner lykkes, er der en sidste drejning: udpeger Snigmorderen Seeren rigtigt, vender Skyggerne spillet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη κι αν πετύχουν 3 αποστολές, μένει μια τελευταία ανατροπή: αν ο Δολοφόνος υποδείξει σωστά τον Μάντη, οι Σκιές ανατρέπουν το παιχνίδι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka 3 tehtävää onnistuisi, jäljellä on vielä viimeinen käänne: jos Salamurhaaja osoittaa Näkijän oikein, Varjot kääntävät pelin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski 3 misi berhasil, masih ada kejutan terakhir: jika Pembunuh menunjuk Peramal dengan tepat, Bayangan membalikkan keadaan."
          }
        },
        "nb" : {
          "stringUnit" : {

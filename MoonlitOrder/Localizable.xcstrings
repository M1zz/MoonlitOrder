        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trò nào cũng có “Cách chơi (luyện tập với bot)”.\nBạn có thể chơi một ván một mình với bot để học luật."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá hra má „Jak hrát (trénink s boty)“.\nMůžeš si sám zahrát jedno kolo s boty a naučit se pravidla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert spil har „Sådan spiller du (øv med bots)“.\nDu kan spille en runde alene med bots for at lære reglerne."
          }
        },
        "el" : {
          "stringUnit" : {

    "동료 도깨비를 확인합니다. 당신이 유일한 도깨비라면 중앙 카드 1장을 볼 수 있습니다. 날이 밝으면 사람인 척 정체를 숨기세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동료 도깨비를 확인합니다. 당신이 유일한 도깨비라면 중앙 카드 1장을 볼 수 있습니다. 날이 밝으면 사람인 척 정체를 숨기세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet your fellow Goblins. If you are the only Goblin, you may look at 1 center card. When day breaks, hide your identity and act human."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet your fellow Goblins. If you are the only Goblin, you may look at 1 centre card. When day breaks, hide your identity and act human."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仲間の鬼を確認します。鬼があなた一人なら、中央のカードを1枚見られます。夜が明けたら、人間のふりをして正体を隠しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认同伴鬼怪。如果你是唯一的鬼怪,可以查看1张中间的牌。天亮后要假装是普通人,隐藏身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認同伴鬼怪。如果你是唯一的鬼怪,可以檢視1張中間的牌。天亮後要假裝是普通人,隱藏身分。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы узнаёте других гоблинов. Если вы единственный гоблин, можете посмотреть 1 центральную карту. Когда рассветёт, скрывайте свою сущность и притворяйтесь человеком."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconoces a tus compañeros Trasgos. Si eres el único Trasgo, puedes mirar 1 carta central. Cuando amanezca, oculta tu identidad y haz como que eres humano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erkennst deine Mit-Kobolde. Bist du der einzige Kobold, darfst du 1 mittlere Karte ansehen. Wenn es hell wird, verbirg deine Identität und tu so, als wärst du ein Mensch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous découvrez vos camarades Gobelins. Si vous êtes le seul Gobelin, vous pouvez regarder 1 carte centrale. Au lever du jour, cachez votre identité et faites comme si vous étiez humain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri i tuoi compagni Goblin. Se sei l’unico Goblin, puoi guardare 1 carta centrale. All’alba, nascondi la tua identità e fingi di essere umano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você reconhece seus companheiros Goblins. Se for o único Goblin, pode olhar 1 carta central. Quando amanhecer, esconda sua identidade e finja ser humano."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูว่าใครคือก็อบลินพวกเดียวกัน ถ้าคุณเป็นก็อบลินคนเดียว จะดูการ์ดกลางได้ 1 ใบ เมื่อฟ้าสาง ให้ซ่อนตัวตนและทำเป็นคนธรรมดา"
          }
        }
      }
    },
    "신통력으로 다른 플레이어 1명의 카드 또는 중앙 카드 2장을 볼 수 있습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신통력으로 다른 플레이어 1명의 카드 또는 중앙 카드 2장을 볼 수 있습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your supernatural sight, look at 1 other player's card or the 2 center cards."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your supernatural sight, look at 1 other player's card or the 2 centre cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不思議な力で、ほかのプレイヤー1人のカード、または中央のカード2枚を見られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凭借神通,可以查看1名其他玩家的牌,或查看中间的2张牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑藉神通,可以檢視1名其他玩家的牌,或檢視中間的2張牌。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сверхъестественным чутьём вы можете посмотреть карту 1 другого игрока или 2 центральные карты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu poder sobrenatural, puedes mirar la carta de 1 jugador o 2 cartas centrales."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit übernatürlicher Kraft darfst du die Karte von 1 anderen Spieler oder 2 mittlere Karten ansehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grâce à votre don surnaturel, vous pouvez regarder la carte d’1 autre joueur ou 2 cartes centrales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il tuo potere soprannaturale puoi guardare la carta di 1 altro giocatore o 2 carte centrali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com seu poder sobrenatural, você pode olhar a carta de 1 outro jogador ou 2 cartas centrais."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ด้วยพลังเหนือธรรมชาติ คุณดูการ์ดของผู้เล่นอื่น 1 คน หรือดูการ์ดกลาง 2 ใบได้"
          }
        }
      }
    },
    "다른 플레이어 1명과 카드를 몰래 바꾸고, 새로 가져온 카드를 확인합니다. 이후 당신의 편은 새 카드를 따릅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 플레이어 1명과 카드를 몰래 바꾸고, 새로 가져온 카드를 확인합니다. 이후 당신의 편은 새 카드를 따릅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secretly swap cards with 1 other player and look at your new card. From then on, your team follows the new card."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secretly swap cards with 1 other player and look at your new card. From then on, your team follows the new card."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのプレイヤー1人とこっそりカードを交換し、手に入れたカードを確認します。以後、あなたの陣営は新しいカードに従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悄悄与1名其他玩家交换牌,并查看换来的新牌。此后你的阵营以新牌为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悄悄與1名其他玩家交換牌,並檢視換來的新牌。此後你的陣營以新牌為準。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайно поменяйтесь картами с 1 другим игроком и посмотрите полученную карту. С этого момента ваша команда определяется новой картой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia en secreto tu carta con 1 jugador y mira la que recibes. A partir de ahí, tu bando sigue la nueva carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausche heimlich die Karte mit 1 anderen Spieler und sieh dir die neue Karte an. Von da an folgt dein Lager der neuen Karte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échangez en secret votre carte avec 1 autre joueur et regardez la nouvelle. Ensuite, votre camp suit la nouvelle carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia di nascosto la tua carta con quella di 1 altro giocatore e guarda la nuova. Da quel momento la tua squadra segue la nuova carta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque em segredo sua carta com 1 outro jogador e olhe a nova. A partir daí, seu lado segue a nova carta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอบสลับการ์ดกับผู้เล่นอื่น 1 คน แล้วดูการ์ดใบใหม่ จากนั้นฝ่ายของคุณจะเป็นไปตามการ์ดใบใหม่"
          }
        }
      }
    },
    "장난기가 발동! 다른 두 플레이어의 카드를 서로 바꿉니다. 무엇이었는지는 볼 수 없습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장난기가 발동! 다른 두 플레이어의 카드를 서로 바꿉니다. 무엇이었는지는 볼 수 없습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischief time! Swap the cards of two other players. You cannot see what they were."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischief time! Swap the cards of two other players. You cannot see what they were."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いたずら心が発動!ほかの2人のカードを入れ替えます。中身は見られません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恶作剧发动!把另外两名玩家的牌互相交换。你看不到那是什么牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "惡作劇發動!把另外兩名玩家的牌互相交換。你看不到那是什麼牌。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проказы начинаются! Поменяйте местами карты двух других игроков. Что это за карты, вы не увидите."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Se activa la travesura! Intercambia las cartas de otros dos jugadores. No podrás ver cuáles eran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schalk packt dich! Vertausche die Karten von zwei anderen Spielern. Du siehst nicht, welche es waren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espièglerie s’éveille ! Échangez les cartes de deux autres joueurs. Vous ne verrez pas lesquelles c’étaient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta lo scherzo! Scambia le carte di altri due giocatori. Non potrai vedere quali fossero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A travessura começa! Troque as cartas de outros dois jogadores. Você não verá quais eram."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความซนมาแล้ว! สลับการ์ดของผู้เล่นอื่นสองคน แต่คุณจะไม่เห็นว่าเป็นการ์ดอะไร"
          }
        }
      }
    },
    "밤에는 할 일이 없습니다. 낮의 추리와 토론으로 숨어든 도깨비를 찾아내세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤에는 할 일이 없습니다. 낮의 추리와 토론으로 숨어든 도깨비를 찾아내세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to do at night. Find the hidden Goblins through daytime reasoning and discussion."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to do at night. Find the hidden Goblins through daytime reasoning and discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜にやることはありません。昼の推理と議論で、潜んだ鬼を見つけ出しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里没有事可做。请通过白天的推理和讨论找出潜伏的鬼怪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡沒有事可做。請透過白天的推理和討論找出潛伏的鬼怪。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью делать нечего. Найдите затаившихся гоблинов с помощью дневных рассуждений и обсуждения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche no tienes nada que hacer. Encuentra a los Trasgos escondidos con el razonamiento y el debate del día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Nacht gibt es nichts zu tun. Finde die versteckten Kobolde mit Schlussfolgern und Diskutieren am Tag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, vous n’avez rien à faire. Trouvez les Gobelins cachés grâce au raisonnement et à la discussion du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte non hai nulla da fare. Trova i Goblin nascosti con il ragionamento e la discussione del giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noite você não tem nada a fazer. Encontre os Goblins escondidos com o raciocínio e a discussão do dia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลางคืนไม่มีอะไรให้ทำ ใช้การวิเคราะห์และการอภิปรายตอนกลางวันหาก็อบลินที่ซ่อนอยู่"
          }
        }
      }
    },

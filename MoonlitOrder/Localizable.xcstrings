    "내보낸 뒤에도 진행 중인 게임은 남은 인원으로 계속됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보낸 뒤에도 진행 중인 게임은 남은 인원으로 계속됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A game in progress continues with the remaining players."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A game in progress continues with the remaining players."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出させたあとも、進行中のゲームは残りの人数で続きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移出之后,进行中的游戏会由剩余的玩家继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

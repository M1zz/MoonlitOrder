        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jogar também com amigos de fora, o app pode ser usado em inglês."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อเล่นกับเพื่อนต่างชาติ ใช้แอปเป็นภาษาอังกฤษได้ด้วย"

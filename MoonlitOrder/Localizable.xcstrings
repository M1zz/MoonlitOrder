    "순서대로 제시어를 한 마디씩 설명하세요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순서대로 제시어를 한 마디씩 설명하세요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the word in a few words, in turn"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the word in a few words, in turn"
          }
        },
        "ja" : {

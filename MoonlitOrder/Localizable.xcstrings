    "밤사이 카드가 바뀌었을 수도 있습니다!\n토론으로 도깨비(현재 카드 기준)를 찾아내세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤사이 카드가 바뀌었을 수도 있습니다!\n토론으로 도깨비(현재 카드 기준)를 찾아내세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards may have changed overnight!\nFind the Goblin (by current card) through discussion."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards may have changed overnight!\nFind the Goblin (by current card) through discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜のあいだにカードが入れ替わったかもしれません!\n議論で鬼(現在のカード基準)を見つけ出しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里牌可能已经被换掉!\n请通过讨论找出鬼怪(以当前的牌为准)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡牌可能已經被換掉!\n請透過討論找出鬼怪(以當前的牌為準)。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За ночь карты могли поменяться!\nНайдите гоблина (по текущей карте) с помощью обсуждения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Las cartas pueden haber cambiado durante la noche!\nEncuentra al Trasgo (según la carta actual) con el debate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Nacht könnten sich Karten geändert haben!\nFinde den Kobold (nach aktueller Karte) durch Diskussion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes ont pu changer pendant la nuit !\nTrouvez le Gobelin (d’après la carte actuelle) par la discussion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le carte potrebbero essere cambiate durante la notte!\nTrova il Goblin (secondo la carta attuale) con la discussione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cartas podem ter mudado durante a noite!\nEncontre o Goblin (pela carta atual) com a discussão."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดอาจเปลี่ยนไประหว่างคืน!\nหาก็อบลิน (ตามการ์ดปัจจุบัน) ด้วยการอภิปราย"
          }
        }
      }
    },

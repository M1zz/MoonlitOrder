    "원정대 구성이 %lld회 연속 부결되어 그림자 진영이 승리했습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원정대 구성이 %lld회 연속 부결되어 그림자 진영이 승리했습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The team was rejected %lld times in a row. The Shadows win."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The team was rejected %lld times in a row. The Shadows win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊の編成が%lld回連続で否決され、影陣営が勝利しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远征队连续%lld次被否决,暗影阵营获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊連續%lld次被否決,暗影陣營獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состав отряда отклонён %lld раз подряд, и побеждают Тени."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equipo fue rechazado %lld veces seguidas y las Sombras ganan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Team wurde %lld-mal in Folge abgelehnt. Die Schatten gewinnen."
          }
        }
      }
    },
    "미션이 3회 실패하여 그림자 진영이 승리했습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션이 3회 실패하여 그림자 진영이 승리했습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three missions failed. The Shadows win."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three missions failed. The Shadows win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッションが3回失敗し、影陣営が勝利しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务失败了3次,暗影阵营获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任務失敗了3次,暗影陣營獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три миссии провалены, и побеждают Тени."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallaron 3 misiones y las Sombras ganan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Missionen sind gescheitert. Die Schatten gewinnen."
          }
        }
      }
    },
    "암살자가 예언자 '%@'을(를) 정확히 찾아냈습니다. 그림자 진영의 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자가 예언자 '%@'을(를) 정확히 찾아냈습니다. 그림자 진영의 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin correctly found the Seer, '%@'. The Shadows turn the tables!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin correctly found the Seer, '%@'. The Shadows turn the tables!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者が予言者「%@」を見事に見抜きました。影陣営の逆転勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客准确找出了预言家“%@”。暗影阵营逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客準確找出了預言家“%@”。暗影陣營逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убийца точно вычислил пророка — «%@». Тени побеждают в последний момент!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Asesino encontró con acierto al Vidente, «%@». ¡Las Sombras remontan!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter hat den Seher „%@“ genau erkannt. Die Schatten drehen das Spiel!"
          }
        }
      }
    },
    "암살자의 칼끝이 빗나갔습니다. '%@'은(는) 예언자가 아니었습니다. 달빛 결사의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자의 칼끝이 빗나갔습니다. '%@'은(는) 예언자가 아니었습니다. 달빛 결사의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin missed. '%@' was not the Seer. The Moonlit Order wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin missed. '%@' was not the Seer. The Moonlit Order wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者の刃は外れました。「%@」は予言者ではありませんでした。月光結社の勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客的刀刃落空了。“%@”并不是预言家。月光结社获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客的刀刃落空了。“%@”並不是預言家。月光結社獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убийца промахнулся. «%@» не был пророком. Побеждает Лунный орден!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Asesino falló. «%@» no era el Vidente. ¡La Orden Lunar gana!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter lag daneben. „%@“ war nicht der Seher. Der Mondorden gewinnt!"
          }
        }
      }
    },
    "전원 역할 확인 처리 후 원정대 지명으로 넘어갑니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 역할 확인 처리 후 원정대 지명으로 넘어갑니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone is treated as having seen their role. Moving on to team selection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone is treated as having seen their role. Moving on to team selection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が役職を確認したものとして、遠征隊の指名に進みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为全员已确认身份,进入远征队提名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為全員已確認身分,進入遠征隊提名。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все считаются узнавшими свои роли. Переходим к выбору отряда."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se da por hecho que todos vieron su rol. Pasamos a la elección del equipo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gelten als informiert über ihre Rolle. Weiter zur Teamwahl."
          }
        }
      }
    },
    "지명하지 않는 리더를 건너뛰고 다음 리더에게 넘깁니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지명하지 않는 리더를 건너뛰고 다음 리더에게 넘깁니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipping the leader who did not choose a team. Passing the lead to the next player."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipping the leader who did not choose a team. Passing the lead to the next player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指名しないリーダーを飛ばして、次のリーダーに交代します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过没有提名的队长,轮到下一位队长。"
          }
        },
        "zh-Hant" : {

    "도깨비(최종 카드 기준)를 추방하면 승리. 도깨비가 모두 중앙 카드에 있다면, 아무도 추방하지 않아야 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비(최종 카드 기준)를 추방하면 승리. 도깨비가 모두 중앙 카드에 있다면, 아무도 추방하지 않아야 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win by banishing a Goblin (by final card). If every Goblin is among the center cards, you win only if nobody is banished."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win by banishing a Goblin (by final card). If every Goblin is among the centre cards, you win only if nobody is banished."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼(最終カード基準)を追放すれば勝利。鬼がすべて中央のカードにある場合は、誰も追放しなければ勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放逐鬼怪(以最终的牌为准)即获胜。如果鬼怪全都在中间的牌里,则不放逐任何人才算获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放逐鬼怪(以最終的牌為準)即獲勝。如果鬼怪全都在中間的牌裡,則不放逐任何人才算獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, изгнав гоблина (по финальной карте). Если все гоблины в центре, вы побеждаете, только если никого не изгнали."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si expulsas a un Trasgo (según la carta final). Si todos los Trasgos están entre las cartas centrales, ganas solo si no se expulsa a nadie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn ein Kobold (nach letzter Karte) verbannt wird. Liegen alle Kobolde in der Mitte, gewinnst du nur, wenn niemand verbannt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gagnez en bannissant un Gobelin (d’après la carte finale). Si tous les Gobelins sont au centre, vous gagnez seulement si personne n’est banni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinci se bandisci un Goblin (secondo la carta finale). Se tutti i Goblin sono tra le carte centrali, vinci solo se non viene bandito nessuno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vence banindo um Goblin (pela carta final). Se todos os Goblins estiverem no centro, você só vence se ninguém for banido."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชนะถ้าขับไล่ก็อบลินได้ (ดูจากการ์ดสุดท้าย) ถ้าก็อบลินอยู่ในการ์ดกลางทั้งหมด จะชนะก็ต่อเมื่อไม่มีใครถูกขับไล่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thắng khi trục xuất được Yêu tinh (theo lá bài cuối). Nếu tất cả Yêu tinh nằm ở bài giữa, bạn chỉ thắng khi không ai bị trục xuất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhráváš, pokud vyženeš skřeta (podle konečné karty). Pokud jsou všichni skřeti mezi prostředními kartami, vyhráváš jen tehdy, když nikdo vyhnán není."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinder, hvis du forviser en goblin (efter det endelige kort). Ligger alle goblins i midten, vinder du kun, hvis ingen forvises."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κερδίζεις αν εξορίσεις έναν Καλλικάντζαρο (με βάση την τελική κάρτα). Αν όλοι οι Καλλικάντζαροι είναι στις κεντρικές κάρτες, κερδίζεις μόνο αν δεν εξοριστεί κανείς."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voitat, jos karkotat menninkäisen (lopullisen kortin mukaan). Jos kaikki menninkäiset ovat keskikorteissa, voitat vain, jos ketään ei karkoteta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menang jika berhasil mengusir Goblin (berdasarkan kartu akhir). Jika semua Goblin ada di kartu tengah, kamu hanya menang bila tidak ada yang diusir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinner hvis du forviser en goblin (etter sluttkortet). Ligger alle goblinene i midten, vinner du bare hvis ingen forvises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wint door een goblin (op eindkaart) te verbannen. Liggen alle goblins in het midden, dan win je alleen als niemand wordt verbannen."
          }
        }
      }
    },
    "도깨비가 한 명도 추방되지 않으면 승리 — 애꿎은 사람이 추방돼도 이겨요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비가 한 명도 추방되지 않으면 승리 — 애꿎은 사람이 추방돼도 이겨요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if no Goblin is banished. You win even if an innocent player is banished."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if no Goblin is banished. You win even if an innocent player is banished."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼が一人も追放されなければ勝利 — 無実の人が追放されても勝ちです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要没有鬼怪被放逐就获胜 — 即使无辜的人被放逐也算赢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要沒有鬼怪被放逐就獲勝 — 即使無辜的人被放逐也算贏。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если ни один гоблин не изгнан — даже если изгнали невиновного."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si no se expulsa a ningún Trasgo — ganas incluso si expulsan a un inocente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn kein Kobold verbannt wird — auch wenn ein Unschuldiger verbannt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gagnez si aucun Gobelin n’est banni — même si un innocent est banni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinci se nessun Goblin viene bandito — vinci anche se viene bandito un innocente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vence se nenhum Goblin for banido — vence até se um inocente for banido."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชนะถ้าไม่มีก็อบลินถูกขับไล่เลย — แม้คนบริสุทธิ์ถูกขับไล่ก็ชนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thắng nếu không có Yêu tinh nào bị trục xuất — thắng cả khi một người vô tội bị trục xuất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhráváš, pokud není vyhnán žádný skřet — vyhráváš i tehdy, když je vyhnán nevinný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinder, hvis ingen goblin forvises — du vinder også, hvis en uskyldig forvises."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κερδίζεις αν δεν εξοριστεί κανένας Καλλικάντζαρος — κερδίζεις ακόμη κι αν εξοριστεί ένας αθώος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voitat, jos yhtään menninkäistä ei karkoteta — voitat, vaikka syytön karkotettaisiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menang jika tidak ada Goblin yang diusir — kamu tetap menang meski orang tidak bersalah diusir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinner hvis ingen goblin forvises — du vinner også om en uskyldig forvises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wint als er geen goblin wordt verbannen — je wint ook als een onschuldige wordt verbannen."
          }
        }
      }
    },

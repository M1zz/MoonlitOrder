    "암살자가 방을 떠나 달빛 결사의 승리로 끝났습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자가 방을 떠나 달빛 결사의 승리로 끝났습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin left the room. The Moonlit Order wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin left the room. The Moonlit Order wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者が部屋を出たため、月光結社の勝利で終わりました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客离开了房间,月光结社获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客離開了房間,月光結社獲勝。"
          }
        }
      }
    },
    "플레이어" : {

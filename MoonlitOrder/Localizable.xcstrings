    "다른 사람에게 보이지 않게! 그리기 쉬운 걸 고르면 유리해요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람에게 보이지 않게! 그리기 쉬운 걸 고르면 유리해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it hidden from others! Picking something easy to draw helps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it hidden from others! Picking something easy to draw helps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの人に見えないように!描きやすいものを選ぶと有利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别让别人看到!选个好画的会更有利。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別讓別人看到!選個好畫的會更有利。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы никто не видел! Выбрав то, что легко рисовать, вы получите преимущество."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Que nadie la vea! Elegir algo fácil de dibujar te conviene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig es niemandem! Ein leicht zu zeichnendes Wort ist von Vorteil."
          }
        }
      }
    },

    "실패 카드가 나왔지만 이번 원정은 %lld장이 필요해 버텨냈습니다!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실패 카드가 나왔지만 이번 원정은 %lld장이 필요해 버텨냈습니다!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fail card was played, but this mission needed %lld, so it held!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fail card was played, but this mission needed %lld, so it held!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗カードが出ましたが、今回の遠征は%lld枚必要なので持ちこたえました!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

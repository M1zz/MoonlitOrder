          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisessa pelissä on ”Näin pelaat (harjoittelu botteja vastaan)”.\nVoit pelata yksin yhden kierroksen botteja vastaan oppiaksesi säännöt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

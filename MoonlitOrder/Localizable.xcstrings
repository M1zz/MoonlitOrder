          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра в процессе продолжится с оставшимися игроками."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partida en curso continúa con los jugadores restantes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein laufendes Spiel geht mit den übrigen Spielern weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie en cours continue avec les joueurs restants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una partita in corso continua con i giocatori rimasti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma partida em andamento continua com os jogadores restantes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมที่กำลังเล่นอยู่จะดำเนินต่อกับผู้เล่นที่เหลือ"

    "'%@'이(가) 라이어였습니다!\n하지만 제시어를 맞히면 라이어가 역전승합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'이(가) 라이어였습니다!\n하지만 제시어를 맞히면 라이어가 역전승합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' was the Liar!\nBut if the Liar guesses the word, the Liar turns the tables."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' was the Liar!\nBut if the Liar guesses the word, the Liar turns the tables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」がライアーでした!\nでもお題を当てればライアーの逆転勝利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”就是说谎者!\n但如果猜中题词,说谎者就能逆转获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”就是說謊者!\n但如果猜中題詞,說謊者就能逆轉獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» оказался лжецом!\nНо если он угадает слово, то победит в последний момент."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡«%@» era el Mentiroso!\nPero si adivina la palabra, el Mentiroso remonta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ war der Lügner!\nErrät er aber das Wort, dreht der Lügner das Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » était le Menteur !\nMais s’il devine le mot, le Menteur renverse la partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» era il Bugiardo!\nMa se indovina la parola, il Bugiardo ribalta la partita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» era o Mentiroso!\nMas se ele acertar a palavra, o Mentiroso vira o jogo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” คือไลเออร์!\nแต่ถ้าทายคำถูก ไลเออร์จะพลิกชนะ"
          }
        }
      }
    },
    "제시어를 골라보세요 — 단 한 번의 기회!" : {
      "localizations" : {
        "ko" : {

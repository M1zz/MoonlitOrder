    "밤에는 할 일이 없습니다. 낮의 추리와 토론으로 숨어든 도깨비를 찾아내세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤에는 할 일이 없습니다. 낮의 추리와 토론으로 숨어든 도깨비를 찾아내세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to do at night. Find the hidden Goblins through daytime reasoning and discussion."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to do at night. Find the hidden Goblins through daytime reasoning and discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜にやることはありません。昼の推理と議論で、潜んだ鬼を見つけ出しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里没有事可做。请通过白天的推理和讨论找出潜伏的鬼怪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡沒有事可做。請透過白天的推理和討論找出潛伏的鬼怪。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью делать нечего. Найдите затаившихся гоблинов с помощью дневных рассуждений и обсуждения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche no tienes nada que hacer. Encuentra a los Trasgos escondidos con el razonamiento y el debate del día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Nacht gibt es nichts zu tun. Finde die versteckten Kobolde mit Schlussfolgern und Diskutieren am Tag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, vous n’avez rien à faire. Trouvez les Gobelins cachés grâce au raisonnement et à la discussion du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte non hai nulla da fare. Trova i Goblin nascosti con il ragionamento e la discussione del giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noite você não tem nada a fazer. Encontre os Goblins escondidos com o raciocínio e a discussão do dia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลางคืนไม่มีอะไรให้ทำ ใช้การวิเคราะห์และการอภิปรายตอนกลางวันหาก็อบลินที่ซ่อนอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ban đêm bạn không có việc gì để làm. Hãy tìm ra các Yêu tinh ẩn nấp bằng suy luận và thảo luận ban ngày."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V noci není co dělat. Skryté skřety vypátrej dedukcí a diskusí ve dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om natten er der intet at lave. Find de skjulte goblins med afledning og debat om dagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τη νύχτα δεν έχεις τίποτα να κάνεις. Βρες τους κρυμμένους Καλλικαντζάρους με λογική και συζήτηση την ημέρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöllä ei ole mitään tekemistä. Etsi piileskelevät menninkäiset päiväsaikaan päättelemällä ja keskustelemalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malam hari tidak ada yang bisa dilakukan. Temukan Goblin yang bersembunyi lewat penalaran dan diskusi di siang hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om natten er det ingenting å gjøre. Finn de skjulte goblinene med resonnering og debatt om dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’s Nachts is er niets te doen. Vind de verborgen goblins door overdag te redeneren en te discussiëren."
          }
        }

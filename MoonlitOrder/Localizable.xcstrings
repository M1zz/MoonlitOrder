            "value" : "Lần lượt mô tả từ khóa bằng vài lời"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Střídavě stručně popisujte slovo"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv på skift ordet med få ord"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιγράψτε με τη σειρά τη λέξη με λίγα λόγια"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaile sanaa vuorotellen muutamalla sanalla"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergantian jelaskan kata dengan singkat"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv ordet etter tur med få ord"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf het woord om de beurt met een paar woorden"
          }
        }
      }
    },
    "너무 자세히 말하면 라이어에게 힌트가 되고,\n너무 애매하면 당신이 의심받아요!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 자세히 말하면 라이어에게 힌트가 되고,\n너무 애매하면 당신이 의심받아요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say too much and you help the Liar.\nSay too little and you look suspicious!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say too much and you help the Liar.\nSay too little and you look suspicious!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳しく言いすぎるとライアーのヒントになり、\nあいまいすぎるとあなたが疑われます!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说得太详细会给说谎者提示,\n说得太含糊又会被你怀疑!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說得太詳細會給說謊者提示,\n說得太含糊又會被你懷疑!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажете слишком подробно — подскажете лжецу,\nслишком расплывчато — заподозрят вас!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hablas demasiado, ayudas al Mentiroso;\nsi eres demasiado vago, sospecharán de ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagst du zu viel, hilfst du dem Lügner,\nsagst du zu wenig, wirst du verdächtigt!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous en dites trop, vous aidez le Menteur ;\nsi vous êtes trop vague, on vous soupçonnera !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dici troppo, aiuti il Bugiardo;\nse sei troppo vago, sospetteranno di te!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se falar demais, ajuda o Mentiroso;\nse for vago demais, vão suspeitar de você!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดละเอียดเกินไปจะเป็นคำใบ้ให้ไลเออร์\nพูดคลุมเครือเกินไปคุณจะถูกสงสัย!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói quá chi tiết sẽ gợi ý cho Kẻ Nói Dối,\nnói quá mơ hồ thì bạn sẽ bị nghi ngờ!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když řekneš příliš, pomůžeš Lháři;\nkdyž řekneš příliš málo, budou podezírat tebe!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siger du for meget, hjælper du Løgneren;\nsiger du for lidt, bliver du mistænkt!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν πεις πολλά, βοηθάς τον Ψεύτη·\nαν πεις πολύ λίγα, θα σε υποψιαστούν!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos kerrot liikaa, autat Valehtelijaa;\njos liian vähän, sinua aletaan epäillä!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika terlalu rinci, kamu membantu Si Pembohong;\njika terlalu samar, kamu dicurigai!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sier du for mye, hjelper du Løgneren;\nsier du for lite, blir du mistenkt!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg je te veel, dan help je de Leugenaar;\nzeg je te weinig, dan word je verdacht!"
          }
        }
      }
    },

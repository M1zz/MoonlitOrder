    "최다 득표자가 추방됩니다 · 동률이면 모두 · 전원이 1표 이하면 아무도 추방되지 않아요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최다 득표자가 추방됩니다 · 동률이면 모두 · 전원이 1표 이하면 아무도 추방되지 않아요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player with the most votes is banished · A tie banishes everyone tied · If everyone has 1 vote or fewer, nobody is banished"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player with the most votes is banished · A tie banishes everyone tied · If everyone has 1 vote or fewer, nobody is banished"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多得票者が追放されます ・ 同数なら全員 ・ 全員が1票以下なら誰も追放されません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "得票最多的人被放逐 · 并列则全部放逐 · 所有人都不超过1票则无人被放逐"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "得票最多的人被放逐 · 並列則全部放逐 · 所有人都不超過1票則無人被放逐"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игрок с наибольшим числом голосов изгоняется · при равенстве — все · если у всех не больше 1 голоса, не изгоняется никто"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El más votado será expulsado · si hay empate, todos los empatados · si todos tienen 1 voto o menos, no se expulsa a nadie"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die meisten Stimmen hat, wird verbannt · Bei Gleichstand alle Gleichauf · Haben alle höchstens 1 Stimme, wird niemand verbannt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus voté est banni · en cas d’égalité, tous les ex æquo · si tout le monde a 1 voix ou moins, personne n’est banni"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più votato viene bandito · in caso di parità tutti i pari · se tutti hanno 1 voto o meno, non viene bandito nessuno"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais votado será banido · em caso de empate, todos os empatados · se todos tiverem 1 voto ou menos, ninguém é banido"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ได้คะแนนโหวตมากที่สุดถูกขับไล่ · ถ้าเท่ากัน ขับไล่ทุกคนที่เท่ากัน · ถ้าทุกคนได้ไม่เกิน 1 คะแนน จะไม่มีใครถูกขับไล่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người nhiều phiếu nhất bị trục xuất · hòa thì tất cả người hòa · nếu ai cũng có từ 1 phiếu trở xuống, không ai bị trục xuất"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo má nejvíc hlasů, bude vyhnán · při shodě všichni se shodou · pokud mají všichni nejvýš 1 hlas, nikdo vyhnán není"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den med flest stemmer forvises · ved lige mange alle de ligestillede · hvis alle har højst 1 stemme, forvises ingen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός με τις περισσότερες ψήφους εξορίζεται · σε ισοπαλία όλοι οι ισόπαλοι · αν όλοι έχουν το πολύ 1 ψήφο, δεν εξορίζεται κανείς"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eniten ääniä saanut karkotetaan · tasatilanteessa kaikki tasapisteiset · jos kaikilla on enintään 1 ääni, ketään ei karkoteta"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang suaranya terbanyak diusir · jika seri semua yang seri · jika semua hanya mendapat 1 suara atau kurang, tidak ada yang diusir"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den med flest stemmer forvises · ved likt alle likestilte · hvis alle har høyst 1 stemme, forvises ingen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

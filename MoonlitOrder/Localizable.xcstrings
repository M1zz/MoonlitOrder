    "대비를 높이거나 색을 구별하기 어려워도 진영과 결과를 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: color and contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell teams and results apart, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 진영과 결과를 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell teams and results apart, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり色の区別がつきにくくても、陣営や結果がわかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使提高对比度或难以分辨颜色,也能看清阵营和结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使提高對比度或難以分辨顏色,也能看清陣營和結果。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при повышенной контрастности или трудностях с цветами вы различите стороны и результаты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque aumentes el contraste o te cueste distinguir colores, podrás reconocer los bandos y los resultados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei erhöhtem Kontrast oder Schwierigkeiten mit Farben erkennst du Lager und Ergebnisse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même avec un contraste renforcé ou des difficultés à distinguer les couleurs, vous reconnaîtrez les camps et les résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con contrasto elevato o difficoltà a distinguere i colori, riconoscerai le squadre e i risultati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com contraste aumentado ou dificuldade para distinguir cores, você reconhecerá os lados e os resultados."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้เพิ่มคอนทราสต์หรือแยกสีได้ยาก คุณก็ยังดูฝ่ายและผลได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù tăng độ tương phản hay khó phân biệt màu, bạn vẫn nhận ra các phe và kết quả."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I se zvýšeným kontrastem nebo potížemi s rozlišením barev poznáš strany i výsledky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med øget kontrast eller svært ved at skelne farver kan du se holdene og resultaterne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη κι αν αυξήσεις την αντίθεση ή δυσκολεύεσαι να ξεχωρίσεις χρώματα, θα αναγνωρίζεις τις πλευρές και τα αποτελέσματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka korostaisit kontrastia tai värien erottaminen olisi vaikeaa, tunnistat puolet ja tulokset."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski kontras ditingkatkan atau sulit membedakan warna, kamu tetap bisa mengenali pihak dan hasil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med økt kontrast eller vansker med å skille farger kan du se lagene og resultatene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook met meer contrast of moeite met kleuren herken je de kampen en de uitslagen."
          }
        }
      }
    },

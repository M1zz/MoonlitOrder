        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หัวหน้าเลือกทีมที่จะออกปฏิบัติภารกิจนี้ กด “ถัดไป” แล้วหัวหน้าจะเลือกทีม (ถ้าคุณเป็นหัวหน้า เลือกเองเลย!)"
          }

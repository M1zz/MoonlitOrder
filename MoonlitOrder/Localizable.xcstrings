    "암살자가 방을 떠나 달빛 결사의 승리로 끝났습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자가 방을 떠나 달빛 결사의 승리로 끝났습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin left the room. The Moonlit Order wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin left the room. The Moonlit Order wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者が部屋を出たため、月光結社の勝利で終わりました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客离开了房间,月光结社获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客離開了房間,月光結社獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убийца покинул комнату, и Лунный орден побеждает."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Asesino abandonó la sala y la Orden Lunar gana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter hat den Raum verlassen. Der Mondorden gewinnt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassin a quitté la salle. L’Ordre Lunaire l’emporte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassino ha lasciato la stanza. L’Ordine Lunare vince."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Assassino saiu da sala. A Ordem Lunar vence."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักฆ่าออกจากห้องไป ภาคีแสงจันทร์ชนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sát Thủ đã rời phòng. Hội Ánh Trăng thắng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrah opustil místnost. Měsíční řád vyhrává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snigmorderen forlod rummet. Måneordenen vinder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Δολοφόνος έφυγε από το δωμάτιο. Το Τάγμα της Σελήνης κερδίζει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salamurhaaja poistui huoneesta. Kuuordo voittaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembunuh meninggalkan ruangan. Ordo Cahaya Bulan menang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snikmorderen forlot rommet. Månordenen vinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Moordenaar heeft de kamer verlaten. De Maanorde wint."
          }
        }
      }
    },

    "밤에는 각자 몰래 행동해요. 내 역할을 확인하고 행동을 마친 뒤, '다음'으로 봇들의 밤 행동을 진행하세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤에는 각자 몰래 행동해요. 내 역할을 확인하고 행동을 마친 뒤, '다음'으로 봇들의 밤 행동을 진행하세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At night everyone acts in secret. Check your role and finish your action, then tap 'Next' to run the bots' night actions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At night everyone acts in secret. Check your role and finish your action, then tap 'Next' to run the bots' night actions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜はそれぞれこっそり行動します。自分の役職を確認して行動を終えたら、「次へ」でボットの夜の行動を進めましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里每个人都悄悄行动。确认自己的身份并完成行动后,点“下一步”推进机器人的夜间行动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡每個人都悄悄行動。確認自己的身分並完成行動後,點“下一步”推進機器人的夜間行動。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью каждый действует тайно. Посмотрите свою роль и завершите действие, затем нажмите «Далее», чтобы выполнить ночные действия ботов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche, cada quien actúa en secreto. Mira tu rol y termina tu acción; luego pulsa «Siguiente» para que los bots hagan sus acciones nocturnas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts handelt jeder heimlich. Sieh dir deine Rolle an und beende deine Aktion, dann tippe auf „Weiter“, um die Nachtaktionen der Bots auszuführen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, chacun agit en secret. Regardez votre rôle et terminez votre action, puis touchez « Suivant » pour faire jouer les actions de nuit des bots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte ognuno agisce di nascosto. Guarda il tuo ruolo e termina la tua azione, poi tocca «Avanti» per eseguire le azioni notturne dei bot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noite, cada um age em segredo. Veja seu papel e termine sua ação, depois toque em «Próximo» para executar as ações noturnas dos bots."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลางคืนทุกคนทำการกระทำแบบลับ ๆ ดูบทบาทและทำให้เสร็จ แล้วกด “ถัดไป” เพื่อให้บอตทำการกระทำตอนกลางคืน"
          }
        }
      }
    },
    "밤사이 밤손님과 장난꾼이 카드를 바꿨을 수 있어요! 실제 게임에선 여기서 토론합니다. '다음'을 누르면 투표가 시작됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤사이 밤손님과 장난꾼이 카드를 바꿨을 수 있어요! 실제 게임에선 여기서 토론합니다. '다음'을 누르면 투표가 시작됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Night Thief and Prankster may have swapped cards overnight! In a real game, this is where you discuss. Tap 'Next' to start the vote."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Night Thief and Prankster may have swapped cards overnight! In a real game, this is where you discuss. Tap 'Next' to start the vote."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜のあいだに夜泥棒といたずら者がカードを入れ替えたかもしれません!実際のゲームではここで議論します。「次へ」を押すと投票が始まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里夜贼和捣蛋鬼可能已经换了牌!真实游戏中,这里是讨论时间。点“下一步”开始投票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡夜賊和搗蛋鬼可能已經換了牌!真實遊戲中,這裡是討論時間。點“下一步”開始投票。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью ночной вор и шутник могли поменять карты! В настоящей игре здесь идёт обсуждение. Нажмите «Далее», чтобы начать голосование."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Durante la noche, el Ladrón nocturno y el Bromista pueden haber cambiado cartas! En una partida real, aquí se debate. Pulsa «Siguiente» para empezar la votación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Nacht könnten Nachtdieb und Schelm Karten getauscht haben! In einem echten Spiel wird hier diskutiert. Tippe auf „Weiter“, um die Abstimmung zu starten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la nuit, le Voleur de nuit et le Farceur ont pu échanger des cartes ! Dans une vraie partie, on discute ici. Touchez « Suivant » pour lancer le vote."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la notte il Ladro notturno e il Burlone potrebbero aver scambiato delle carte! In una partita vera qui si discute. Tocca «Avanti» per avviare la votazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a noite, o Ladrão noturno e o Brincalhão podem ter trocado cartas! Numa partida real, é aqui que se discute. Toque em «Próximo» para iniciar a votação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างคืน โจรราตรีกับจอมซนอาจสลับการ์ดกันแล้ว! ในเกมจริงตรงนี้คือช่วงอภิปราย กด “ถัดไป” เพื่อเริ่มโหวต"
          }
        }
      }
    },
    "도깨비로 의심되는 사람을 먼저 지목해보고, '다음'으로 봇들의 표를 확인하세요. 최다 득표자가 추방됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비로 의심되는 사람을 먼저 지목해보고, '다음'으로 봇들의 표를 확인하세요. 최다 득표자가 추방됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point first at who you suspect is a Goblin, then tap 'Next' to see the bots' votes. The player with the most votes is banished."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point first at who you suspect is a Goblin, then tap 'Next' to see the bots' votes. The player with the most votes is banished."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼だと思う人をまず指名して、「次へ」でボットの票を確認しましょう。最多得票者が追放されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先指认你怀疑是鬼怪的人,再点“下一步”查看机器人的票。得票最多的人会被放逐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先指認你懷疑是鬼怪的人,再點“下一步”檢視機器人的票。得票最多的人會被放逐。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала укажите, кого подозреваете в роли гоблина, затем нажмите «Далее», чтобы увидеть голоса ботов. Игрок с наибольшим числом голосов будет изгнан."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Señala primero a quien sospeches que es un Trasgo y pulsa «Siguiente» para ver los votos de los bots. El más votado será expulsado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenne zuerst, wen du für einen Kobold hältst, und tippe dann auf „Weiter“, um die Stimmen der Bots zu sehen. Wer die meisten Stimmen hat, wird verbannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désignez d’abord celui que vous soupçonnez d’être un Gobelin, puis touchez « Suivant » pour voir les votes des bots. Le plus voté sera banni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica prima chi sospetti sia un Goblin, poi tocca «Avanti» per vedere i voti dei bot. Il più votato viene bandito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte primeiro quem você suspeita ser um Goblin e toque em «Próximo» para ver os votos dos bots. O mais votado será banido."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชี้คนที่สงสัยว่าเป็นก็อบลินก่อน แล้วกด “ถัดไป” เพื่อดูคะแนนของบอต ผู้ได้คะแนนโหวตมากที่สุดจะถูกขับไล่"
          }
        }
      }
    },

    "같은 Wi-Fi 또는 근거리의 아이폰끼리 자동으로 연결됩니다.\n인터넷 없이도 플레이할 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi 또는 근거리의 아이폰끼리 자동으로 연결됩니다.\n인터넷 없이도 플레이할 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhones on the same Wi-Fi or nearby connect automatically.\nYou can play without internet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhones on the same Wi-Fi or nearby connect automatically.\nYou can play without internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じWi-Fiまたは近くにあるiPhone同士が自動でつながります。\nインターネットなしでも遊べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一Wi-Fi或近距离的iPhone会自动连接。\n没有网络也能玩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一Wi-Fi或近距離的iPhone會自動連線。\n沒有網路也能玩。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone в одной сети Wi-Fi или рядом подключаются автоматически.\nИграть можно и без интернета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iPhone en la misma red Wi-Fi o cercanos se conectan solos.\nPuedes jugar sin internet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhones im selben WLAN oder in der Nähe verbinden sich automatisch.\nDu kannst auch ohne Internet spielen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les iPhone sur le même Wi-Fi ou à proximité se connectent automatiquement.\nVous pouvez jouer sans Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli iPhone sulla stessa rete Wi-Fi o vicini si collegano automaticamente.\nPuoi giocare anche senza Internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhones na mesma rede Wi-Fi ou por perto se conectam automaticamente.\nDá para jogar sem internet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ที่อยู่ใน Wi-Fi เดียวกันหรืออยู่ใกล้กันจะเชื่อมต่อกันเอง\nเล่นได้แม้ไม่มีอินเทอร์เน็ต"
          }
        }
      }
    },

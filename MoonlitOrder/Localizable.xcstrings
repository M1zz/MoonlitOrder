        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使提高對比度或難以分辨顏色,也能看清陣營和結果。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при повышенной контрастности или трудностях с цветами вы различите стороны и результаты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque aumentes el contraste o te cueste distinguir colores, podrás reconocer los bandos y los resultados."

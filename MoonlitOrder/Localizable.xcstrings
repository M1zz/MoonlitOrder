    "'%@'이(가) 라이어였습니다!\n하지만 제시어를 맞히면 라이어가 역전승합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'이(가) 라이어였습니다!\n하지만 제시어를 맞히면 라이어가 역전승합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' was the Liar!\nBut if the Liar guesses the word, the Liar turns the tables."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' was the Liar!\nBut if the Liar guesses the word, the Liar turns the tables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」がライアーでした!\nでもお題を当てればライアーの逆転勝利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”就是说谎者!\n但如果猜中题词,说谎者就能逆转获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”就是說謊者!\n但如果猜中題詞,說謊者就能逆轉獲勝。"
          }
        }
      }
    },

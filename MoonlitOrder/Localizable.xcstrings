    "실제 게임에서는 아무것도 공개되지 않아요. 그래서 토론이 중요합니다!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 게임에서는 아무것도 공개되지 않아요. 그래서 토론이 중요합니다!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

    "다른 플레이어 1명과 카드를 몰래 바꾸고, 새로 가져온 카드를 확인합니다. 이후 당신의 편은 새 카드를 따릅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 플레이어 1명과 카드를 몰래 바꾸고, 새로 가져온 카드를 확인합니다. 이후 당신의 편은 새 카드를 따릅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secretly swap cards with 1 other player and look at your new card. From then on, your team follows the new card."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secretly swap cards with 1 other player and look at your new card. From then on, your team follows the new card."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのプレイヤー1人とこっそりカードを交換し、手に入れたカードを確認します。以後、あなたの陣営は新しいカードに従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悄悄与1名其他玩家交换牌,并查看换来的新牌。此后你的阵营以新牌为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悄悄與1名其他玩家交換牌,並檢視換來的新牌。此後你的陣營以新牌為準。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайно поменяйтесь картами с 1 другим игроком и посмотрите полученную карту. С этого момента ваша команда определяется новой картой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia en secreto tu carta con 1 jugador y mira la que recibes. A partir de ahí, tu bando sigue la nueva carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausche heimlich die Karte mit 1 anderen Spieler und sieh dir die neue Karte an. Von da an folgt dein Lager der neuen Karte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échangez en secret votre carte avec 1 autre joueur et regardez la nouvelle. Ensuite, votre camp suit la nouvelle carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia di nascosto la tua carta con quella di 1 altro giocatore e guarda la nuova. Da quel momento la tua squadra segue la nuova carta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque em segredo sua carta com 1 outro jogador e olhe a nova. A partir daí, seu lado segue a nova carta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอบสลับการ์ดกับผู้เล่นอื่น 1 คน แล้วดูการ์ดใบใหม่ จากนั้นฝ่ายของคุณจะเป็นไปตามการ์ดใบใหม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lén đổi bài với 1 người chơi khác và xem lá bài mới. Từ đó phe của bạn theo lá bài mới."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajně si vyměň kartu s 1 jiným hráčem a podívej se na novou. Od té chvíle se tvá strana řídí novou kartou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt i hemmelighed kort med 1 anden spiller og se det nye kort. Herefter følger dit hold det nye kort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντάλλαξε κρυφά κάρτα με 1 άλλο παίκτη και δες τη νέα. Από εκεί και πέρα η πλευρά σου ακολουθεί τη νέα κάρτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda salaa kortti yhden toisen pelaajan kanssa ja katso uusi kortti. Tämän jälkeen puolesi seuraa uutta korttia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukar kartu secara diam-diam dengan 1 pemain lain dan lihat kartu barumu. Sejak itu pihakmu mengikuti kartu baru."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt kort i hemmelighet med 1 annen spiller og se det nye kortet. Etter det følger laget ditt det nye kortet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel stiekem je kaart met 1 andere speler en bekijk de nieuwe kaart. Vanaf dan volgt jouw kamp de nieuwe kaart."
          }
        }
      }
    },
    "장난기가 발동! 다른 두 플레이어의 카드를 서로 바꿉니다. 무엇이었는지는 볼 수 없습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장난기가 발동! 다른 두 플레이어의 카드를 서로 바꿉니다. 무엇이었는지는 볼 수 없습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischief time! Swap the cards of two other players. You cannot see what they were."

    "미션 3회 실패 · 원정대 5회 연속 부결 · 예언자 암살 성공 — 셋 중 하나면 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 3회 실패 · 원정대 5회 연속 부결 · 예언자 암살 성공 — 셋 중 하나면 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missions fail · 5 teams in a row rejected · the Seer is assassinated. Any one of the three wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missions fail · 5 teams in a row rejected · the Seer is assassinated. Any one of the three wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッション3回失敗 ・ 遠征隊5回連続否決 ・ 予言者の暗殺成功 — この3つのうちどれかで勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务失败3次 · 远征队连续5次被否决 · 刺杀预言家成功 — 三者满足其一即获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任務失敗3次 · 遠征隊連續5次被否決 · 刺殺預言家成功 — 三者滿足其一即獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 проваленные миссии · 5 отклонённых отрядов подряд · успешное убийство пророка — достаточно любого из трёх."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 misiones fallidas · 5 equipos rechazados seguidos · asesinato del Vidente — con cualquiera de las tres ganas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 Missionen scheitern · 5 abgelehnte Teams in Folge · Mord am Seher gelingt — eines von dreien genügt zum Sieg."
          }
        }
      }
    },
    "투표로 라이어를 정확히 지목하고, 라이어가 제시어 추측에 실패하면 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투표로 라이어를 정확히 지목하고, 라이어가 제시어 추측에 실패하면 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the vote correctly names the Liar and the Liar then fails to guess the word."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the vote correctly names the Liar and the Liar then fails to guess the word."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票でライアーを正しく指名し、ライアーがお題の推測に失敗すれば勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过投票准确指认说谎者,且说谎者没能猜中题词,即获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過投票準確指認說謊者,且說謊者沒能猜中題詞,即獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если голосованием точно указали на лжеца, а он не угадал слово."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si la votación señala con acierto al Mentiroso y este no adivina la palabra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn die Abstimmung den Lügner richtig benennt und der Lügner das Wort nicht errät."
          }
        }
      }
    },
    "표가 갈리거나 엉뚱한 사람이 지목되면 승리. 잡히더라도 제시어를 맞히면 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표가 갈리거나 엉뚱한 사람이 지목되면 승리. 잡히더라도 제시어를 맞히면 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the votes are split or the wrong person is accused. Even if caught, guessing the word turns the game around!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the votes are split or the wrong person is accused. Even if caught, guessing the word turns the game around!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票が割れる、または違う人が指名されたら勝利。捕まっても、お題を当てれば逆転勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票数分散或指认错人即获胜。即使被抓,猜中题词也能逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票數分散或指認錯人即獲勝。即使被抓,猜中題詞也能逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если голоса разделились или указали не на того. Даже если лжеца поймали, он побеждает, если угадает слово!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si los votos se dividen o se señala a la persona equivocada. Aunque lo atrapen, si adivina la palabra remonta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn die Stimmen geteilt sind oder die falsche Person beschuldigt wird. Selbst wenn der Lügner gefasst wird, dreht er das Spiel, wenn er das Wort errät!"
          }
        }
      }
    },

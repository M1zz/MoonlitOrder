    "전원 제시어 확인 처리 후 설명 단계로 넘어갑니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 제시어 확인 처리 후 설명 단계로 넘어갑니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone is treated as having seen the word. Moving on to the description phase."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone is treated as having seen the word. Moving on to the description phase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員がお題を確認したものとして、説明の段階に進みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为全员已确认题词,进入描述阶段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為全員已確認題詞,進入描述階段。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все считаются узнавшими слово. Переходим к этапу описания."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se da por hecho que todos vieron la palabra. Pasamos a la fase de descripción."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gelten als informiert über das Wort. Weiter zur Beschreibungsphase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde est considéré comme ayant vu le mot. Passage à la phase de description."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si considera che tutti abbiano visto la parola. Si passa alla fase di descrizione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considera-se que todos viram a palavra. Seguindo para a fase de descrição."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถือว่าทุกคนดูคำแล้ว ไปต่อที่ขั้นอธิบาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coi như mọi người đã xem từ khóa. Chuyển sang giai đoạn mô tả."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všichni se považují za ty, kdo viděli slovo. Přecházíme k fázi popisování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle regnes for at have set ordet. Videre til beskrivelsesfasen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θεωρείται ότι όλοι είδαν τη λέξη. Περνάμε στη φάση περιγραφής."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikkien katsotaan nähneen sanan. Siirrytään kuvausvaiheeseen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua dianggap sudah melihat kata. Lanjut ke tahap deskripsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle regnes som å ha sett ordet. Går videre til beskrivelsesfasen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen geldt als klaar met het bekijken van het woord. Door naar de beschrijffase."
          }
        }
      }
    },
    "현재 발언자의 차례를 끝내고 다음으로 넘깁니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 발언자의 차례를 끝내고 다음으로 넘깁니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ending the current speaker's turn and passing to the next."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ending the current speaker's turn and passing to the next."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の発言者の番を終えて、次の人に進めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束当前发言者的回合,轮到下一位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束當前發言者的回合,輪到下一位。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ход текущего игрока завершается, слово переходит к следующему."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina el turno del orador actual y pasa al siguiente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zug des aktuellen Sprechers endet, der Nächste ist dran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tour de l’orateur actuel se termine, place au suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il turno di chi parla finisce e si passa al successivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vez de quem fala termina e passa para o próximo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จบตาของผู้พูดคนปัจจุบัน แล้วส่งต่อให้คนถัดไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết thúc lượt người đang nói và chuyển cho người tiếp theo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tah aktuálního mluvčího končí a řada přechází na dalšího."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nuværende talers tur slutter, og turen går videre til den næste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σειρά του τρέχοντος ομιλητή τελειώνει και περνά στον επόμενο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyisen puhujan vuoro päättyy ja vuoro siirtyy seuraavalle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giliran pembicara saat ini berakhir, lanjut ke berikutnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nåværende talers tur er over, og turen går til neste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beurt van de huidige spreker eindigt en gaat naar de volgende."
          }
        }
      }
    },
    "아직 투표하지 않은 사람은 기권으로 처리하고 개표합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 투표하지 않은 사람은 기권으로 처리하고 개표합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who have not voted are counted as abstaining. Counting the votes now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players who have not voted are counted as abstaining. Counting the votes now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ投票していない人は棄権として扱い、開票します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未投票的人按弃权处理,开始计票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未投票的人按棄權處理,開始計票。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не проголосовавшие считаются воздержавшимися. Подсчитываем голоса."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes no han votado cuentan como abstención. Se hace el recuento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer noch nicht abgestimmt hat, zählt als Enthaltung. Die Stimmen werden gezählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux qui n’ont pas voté comptent comme abstention. Dépouillement des votes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi non ha votato conta come astenuto. Si contano i voti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem não votou conta como abstenção. Contando os votos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ยังไม่โหวตนับเป็นงดออกเสียง กำลังนับคะแนนโหวต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người chưa bỏ phiếu được tính là bỏ phiếu trắng. Đang kiểm phiếu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo nehlasoval, počítá se jako zdržel se. Sčítají se hlasy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem, der ikke har stemt, tæller som blanke. Stemmerne optælles."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσοι δεν ψήφισαν μετρούν ως αποχή. Μετράμε τις ψήφους."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänestämättömät lasketaan tyhjiksi. Äänet lasketaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang belum memilih dihitung abstain. Suara dihitung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De som ikke har stemt, teller som blanke. Stemmene telles opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie niet gestemd heeft, telt als onthouding. De stemmen worden geteld."
          }
        }
      }
    },
    "라이어의 추측 포기로 처리하고 시민의 승리로 끝냅니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이어의 추측 포기로 처리하고 시민의 승리로 끝냅니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Liar is treated as having given up guessing. The Citizens win."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Liar is treated as having given up guessing. The Citizens win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライアーが推測を放棄したものとして扱い、市民の勝利で終わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视为说谎者放弃猜测,平民获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視為說謊者放棄猜測,平民獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается, что лжец отказался от догадки. Побеждают горожане."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se da por hecho que el Mentiroso renunció a adivinar. Ganan los ciudadanos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lügner gilt als verzichtet. Die Bürger gewinnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Menteur est considéré comme ayant renoncé à deviner. Les citoyens l’emportent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Bugiardo conta come rinunciatario. Vincono i cittadini."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mentiroso é considerado desistente. Os cidadãos vencem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถือว่าไลเออร์สละสิทธิ์ทาย ฝ่ายพลเมืองชนะ"

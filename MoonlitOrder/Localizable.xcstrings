    "원정대에 숨어든 그림자 진영을 찾아내는 5~15인 정체 추리 게임. 미션 3회를 먼저 성공(또는 실패)시키는 진영이 승리합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원정대에 숨어든 그림자 진영을 찾아내는 5~15인 정체 추리 게임. 미션 3회를 먼저 성공(또는 실패)시키는 진영이 승리합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 5–15 player hidden-identity game of finding the Shadows among the team. The side that first succeeds (or fails) 3 missions wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 5–15 player hidden-identity game of finding the Shadows among the team. The side that first succeeds (or fails) 3 missions wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊に潜む影陣営を探し出す、5〜15人の正体推理ゲーム。ミッションを先に3回成功(または失敗)させた陣営の勝ちです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出混入远征队的暗影阵营,5~15人的身份推理游戏。先让任务成功(或失败)3次的阵营获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出混入遠征隊的暗影陣營,5~15人的身分推理遊戲。先讓任務成功(或失敗)3次的陣營獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра на выявление Теней среди отряда для 5–15 игроков. Побеждает сторона, которая первой выполнит (или провалит) 3 миссии."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de identidades ocultas para 5–15 jugadores: descubre a las Sombras infiltradas en el equipo. Gana el bando que primero logre (o falle) 3 misiones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Identitäts-Rätselspiel für 5–15 Spieler: Finde die Schatten, die sich im Team verstecken. Es gewinnt das Lager, das zuerst 3 Missionen schafft (oder scheitern lässt)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeu d’identités cachées pour 5 à 15 joueurs : trouvez les Ombres infiltrées dans l’équipe. Le camp qui réussit (ou fait échouer) 3 missions en premier gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco di identità nascoste per 5–15 giocatori: trova le Ombre infiltrate nel gruppo. Vince la squadra che per prima riesce (o fa fallire) 3 missioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um jogo de identidades ocultas para 5–15 jogadores: encontre as Sombras infiltradas na equipe. Vence o lado que primeiro cumprir (ou fizer falhar) 3 missões."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมสืบหาตัวตนสำหรับ 5–15 คน หาฝ่ายเงามืดที่ซ่อนอยู่ในทีม ฝ่ายที่ทำภารกิจสำเร็จ (หรือล้มเหลว) ครบ 3 ครั้งก่อนเป็นฝ่ายชนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trò chơi suy luận thân phận cho 5–15 người: tìm ra Bóng Tối lẫn trong đội. Phe nào hoàn thành (hoặc làm thất bại) 3 nhiệm vụ trước sẽ thắng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra o skrytých identitách pro 5–15 hráčů: najdi Stíny ukryté v týmu. Vyhrává strana, která jako první splní (nebo zmaří) 3 mise."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spil om skjulte identiteter for 5–15 spillere: find de Skygger, der gemmer sig på holdet. Den side, der først lykkes med (eller får fejlet) 3 missioner, vinder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα παιχνίδι κρυφών ταυτοτήτων για 5–15 παίκτες: βρες τις Σκιές που κρύβονται στην ομάδα. Κερδίζει η πλευρά που θα πετύχει (ή θα αποτύχει) πρώτη 3 αποστολές."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilotettujen henkilöllisyyksien peli 5–15 pelaajalle: etsi ryhmään piiloutuneet Varjot. Voittaja on se puoli, joka ensin saa 3 tehtävää onnistumaan (tai epäonnistumaan)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan identitas tersembunyi untuk 5–15 pemain: temukan Bayangan yang menyusup di tim. Pihak yang lebih dulu berhasil (atau menggagalkan) 3 misi menang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spill om skjulte identiteter for 5–15 spillere: finn Skyggene som gjemmer seg i laget. Den siden som først får 3 oppdrag til å lykkes (eller mislykkes), vinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een spel met verborgen identiteiten voor 5–15 spelers: vind de Schaduwen die zich in het team verstoppen. De kant die als eerste 3 missies laat slagen (of mislukken), wint."
          }
        }
      }
    },
    "라이어만 빼고 모두 같은 제시어를 받는 3~15인 눈치 게임. 한 마디씩 설명한 뒤 라이어를 찾아내세요. 라이어는 잡혀도 제시어를 맞히면 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이어만 빼고 모두 같은 제시어를 받는 3~15인 눈치 게임. 한 마디씩 설명한 뒤 라이어를 찾아내세요. 라이어는 잡혀도 제시어를 맞히면 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 3–15 player bluffing game where everyone except the Liar gets the same word. Describe it in a few words, then find the Liar. Even if caught, the Liar wins by guessing the word!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 3–15 player bluffing game where everyone except the Liar gets the same word. Describe it in a few words, then find the Liar. Even if caught, the Liar wins by guessing the word!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライアー以外の全員が同じお題を受け取る、3〜15人の駆け引きゲーム。ひと言ずつ説明してからライアーを探し出しましょう。ライアーは捕まってもお題を当てれば逆転勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了说谎者,所有人都拿到同一个题词的3~15人斗智游戏。轮流用一句话描述后,找出说谎者。说谎者即使被抓,猜中题词也能逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了說謊者,所有人都拿到同一個題詞的3~15人鬥智遊戲。輪流用一句話描述後,找出說謊者。說謊者即使被抓,猜中題詞也能逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра на блеф для 3–15 игроков: все, кроме лжеца, получают одно слово. Объясните его парой слов, а затем найдите лжеца. Даже пойманный лжец побеждает, если угадает слово!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de faroleo para 3–15 jugadores: todos reciben la misma palabra menos el Mentiroso. Descríbanla con pocas palabras y encuentren al Mentiroso. ¡Aunque lo atrapen, si adivina la palabra gana!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bluffspiel für 3–15 Spieler: Alle außer dem Lügner erhalten dasselbe Wort. Beschreibt es in wenigen Worten und findet dann den Lügner. Auch wenn er gefasst wird, gewinnt der Lügner, wenn er das Wort errät!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeu de bluff pour 3 à 15 joueurs : tout le monde reçoit le même mot sauf le Menteur. Décrivez-le en quelques mots, puis trouvez le Menteur. Même démasqué, le Menteur gagne s’il devine le mot !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco di bluff per 3–15 giocatori: tutti ricevono la stessa parola tranne il Bugiardo. Descrivetela con poche parole e poi trovate il Bugiardo. Anche se scoperto, il Bugiardo vince se indovina la parola!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um jogo de blefe para 3–15 jogadores: todos recebem a mesma palavra, menos o Mentiroso. Descrevam com poucas palavras e depois encontrem o Mentiroso. Mesmo pego, o Mentiroso vence se acertar a palavra!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมหลอกล่อสำหรับ 3–15 คน ทุกคนได้คำเดียวกันยกเว้นไลเออร์ อธิบายคำสั้น ๆ แล้วหาตัวไลเออร์ แม้ถูกจับได้ ไลเออร์ก็พลิกชนะถ้าทายคำถูก!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trò chơi đánh lừa cho 3–15 người: ai cũng nhận cùng một từ khóa trừ Kẻ Nói Dối. Mô tả bằng vài lời rồi tìm Kẻ Nói Dối. Dù bị bắt, Kẻ Nói Dối thắng nếu đoán đúng từ khóa!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blafovací hra pro 3–15 hráčů: všichni kromě Lháře dostanou stejné slovo. Stručně ho popište a pak najděte Lháře. Ani chycený Lhář nemusí prohrát — když slovo uhodne, vyhrává!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bluffespil for 3–15 spillere: alle undtagen Løgneren får det samme ord. Beskriv det med få ord, og find så Løgneren. Selv hvis han fanges, vinder Løgneren ved at gætte ordet!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα παιχνίδι μπλόφας για 3–15 παίκτες: όλοι παίρνουν την ίδια λέξη εκτός από τον Ψεύτη. Περιγράψτε την με λίγα λόγια και βρείτε τον Ψεύτη. Ακόμη κι αν πιαστεί, ο Ψεύτης κερδίζει αν μαντέψει τη λέξη!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluffauspeli 3–15 pelaajalle: kaikki paitsi Valehtelija saavat saman sanan. Kuvailkaa sitä muutamalla sanalla ja etsikää sitten Valehtelija. Vaikka Valehtelija jäisi kiinni, hän voittaa arvaamalla sanan!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan blufing untuk 3–15 pemain: semua kecuali Si Pembohong mendapat kata yang sama. Jelaskan dengan singkat lalu cari Si Pembohong. Meski tertangkap, Si Pembohong menang jika menebak kata!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bløffespill for 3–15 spillere: alle unntatt Løgneren får det samme ordet. Beskriv det med få ord, og finn så Løgneren. Selv om Løgneren blir tatt, vinner han ved å gjette ordet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bluffspel voor 3–15 spelers: iedereen behalve de Leugenaar krijgt hetzelfde woord. Beschrijf het met een paar woorden en zoek dan de Leugenaar. Zelfs als hij gepakt wordt, wint de Leugenaar door het woord te raden!"
          }
        }
      }
    },
    "도깨비가 숨어든 하룻밤의 3~15인 추리 게임. 밤사이 카드가 뒤바뀌고, 단 한 번의 투표로 승패가 갈립니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비가 숨어든 하룻밤의 3~15인 추리 게임. 밤사이 카드가 뒤바뀌고, 단 한 번의 투표로 승패가 갈립니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 3–15 player deduction game about one night with a Goblin among you. Cards get swapped overnight, and a single vote decides the winner."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 3–15 player deduction game about one night with a Goblin among you. Cards get swapped overnight, and a single vote decides the winner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼が忍び込んだ一夜を描く、3〜15人の推理ゲーム。夜のあいだにカードが入れ替わり、たった一度の投票で勝敗が決まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪潜入的一夜,3~15人推理游戏。夜里牌会被换来换去,只靠一次投票决出胜负。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪潛入的一夜,3~15人推理遊戲。夜裡牌會被換來換去,只靠一次投票決出勝負。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детектив на 3–15 игроков об одной ночи с гоблином в деревне. За ночь карты меняются местами, а исход решает одно голосование."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

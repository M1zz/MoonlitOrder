        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expulsaron a un Trasgo. ¡Gana el Pueblo!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kobold wurde verbannt. Das Dorf gewinnt!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Gobelin a été banni. Le Village l’emporte !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Goblin è stato bandito. Vince il Villaggio!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Goblin foi banido. A Vila vence!"
          }

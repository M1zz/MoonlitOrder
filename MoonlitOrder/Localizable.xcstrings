    "암살자가 예언자 '%@'을(를) 정확히 찾아냈습니다. 그림자 진영의 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자가 예언자 '%@'을(를) 정확히 찾아냈습니다. 그림자 진영의 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin correctly found the Seer, '%@'. The Shadows turn the tables!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin correctly found the Seer, '%@'. The Shadows turn the tables!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者が予言者「%@」を見事に見抜きました。影陣営の逆転勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客准确找出了预言家“%@”。暗影阵营逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客準確找出了預言家“%@”。暗影陣營逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убийца точно вычислил пророка — «%@». Тени побеждают в последний момент!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Asesino encontró con acierto al Vidente, «%@». ¡Las Sombras remontan!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter hat den Seher „%@“ genau erkannt. Die Schatten drehen das Spiel!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassin a démasqué l’Oracle, « %@ ». Les Ombres renversent la partie !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassino ha individuato il Veggente, «%@». Le Ombre ribaltano la partita!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Assassino identificou corretamente o Vidente, «%@». As Sombras viram o jogo!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักฆ่าชี้ตัวผู้ทำนาย “%@” ได้ถูกต้อง ฝ่ายเงามืดพลิกชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sát Thủ đã tìm đúng Nhà Tiên Tri “%@”. Phe Bóng Tối lật ngược thế cờ!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrah přesně našel Věštce „%@“. Stíny otáčejí hru!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snigmorderen fandt præcis Seeren, „%@“. Skyggerne vender spillet!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Δολοφόνος βρήκε με ακρίβεια τον Μάντη, «%@». Οι Σκιές ανατρέπουν το παιχνίδι!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salamurhaaja löysi Näkijän, ”%@”, oikein. Varjot kääntävät pelin!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembunuh tepat menemukan Peramal, “%@”. Bayangan membalikkan keadaan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snikmorderen fant Seeren, «%@», med presisjon. Skyggene snur spillet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Moordenaar heeft de Ziener, ‘%@’, precies gevonden. De Schaduwen keren het spel!"
          }
        }
      }
    },
    "암살자의 칼끝이 빗나갔습니다. '%@'은(는) 예언자가 아니었습니다. 달빛 결사의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암살자의 칼끝이 빗나갔습니다. '%@'은(는) 예언자가 아니었습니다. 달빛 결사의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin missed. '%@' was not the Seer. The Moonlit Order wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Assassin missed. '%@' was not the Seer. The Moonlit Order wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗殺者の刃は外れました。「%@」は予言者ではありませんでした。月光結社の勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客的刀刃落空了。“%@”并不是预言家。月光结社获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刺客的刀刃落空了。“%@”並不是預言家。月光結社獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убийца промахнулся. «%@» не был пророком. Побеждает Лунный орден!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Asesino falló. «%@» no era el Vidente. ¡La Orden Lunar gana!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Attentäter lag daneben. „%@“ war nicht der Seher. Der Mondorden gewinnt!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassin s’est trompé. « %@ » n’était pas l’Oracle. L’Ordre Lunaire l’emporte !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Assassino ha sbagliato. «%@» non era il Veggente. Vince l’Ordine Lunare!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Assassino errou. «%@» não era o Vidente. A Ordem Lunar vence!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักฆ่าพลาดเป้า “%@” ไม่ใช่ผู้ทำนาย ภาคีแสงจันทร์ชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sát Thủ đã đoán sai. “%@” không phải Nhà Tiên Tri. Hội Ánh Trăng thắng!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrah se netrefil. „%@“ nebyl Věštec. Měsíční řád vyhrává!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snigmorderen ramte ved siden af. „%@“ var ikke Seeren. Måneordenen vinder!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Δολοφόνος αστόχησε. Ο/Η «%@» δεν ήταν ο Μάντης. Το Τάγμα της Σελήνης κερδίζει!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salamurhaaja huitaisi ohi. ”%@” ei ollut Näkijä. Kuuordo voittaa!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembunuh meleset. “%@” bukan Peramal. Ordo Cahaya Bulan menang!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snikmorderen bommet. «%@» var ikke Seeren. Månordenen vinner!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Moordenaar greep mis. ‘%@’ was niet de Ziener. De Maanorde wint!"
          }
        }
      }
    },
    "전원 역할 확인 처리 후 원정대 지명으로 넘어갑니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 역할 확인 처리 후 원정대 지명으로 넘어갑니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone is treated as having seen their role. Moving on to team selection."
          }

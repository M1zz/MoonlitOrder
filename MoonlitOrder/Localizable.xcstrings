          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien no actuó termina la noche sin usar su poder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer nicht gehandelt hat, beendet die Nacht ohne Fähigkeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vůdce vybírá tým pro tuto misi. Klepni na „Další“ a vůdce tým vybere. (Pokud jsi vůdce, vyber ho sám!)"

    "모두 앱을 설치한 뒤, 한 사람이 게임을 골라 '방 만들기'를 눌러요.\n나머지는 '게임 참가'로 그 방에 들어오면 끝!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 앱을 설치한 뒤, 한 사람이 게임을 골라 '방 만들기'를 눌러요.\n나머지는 '게임 참가'로 그 방에 들어오면 끝!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After everyone installs the app, one person picks a game and taps 'Create a Room'.\nEveryone else taps 'Join a Game' and they're in!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After everyone installs the app, one person picks a game and taps 'Create a Room'.\nEveryone else taps 'Join a Game' and they're in!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員がアプリをインストールしたら、1人がゲームを選んで「部屋を作る」を押します。\n残りの人は「ゲームに参加」でその部屋に入れば完了!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家都安装应用后,由一个人选游戏并点“创建房间”。\n其他人通过“加入游戏”进入房间就行了!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家都安裝App後,由一個人選遊戲並點“建立房間”。\n其他人透過“加入遊戲”進入房間就行了!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда все установят приложение, один игрок выбирает игру и нажимает «Создать комнату».\nОстальные заходят в неё через «Присоединиться к игре» — и всё!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando todos hayan instalado la app, una persona elige un juego y pulsa «Crear sala».\n¡Los demás entran con «Unirse a una partida» y listo!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn alle die App installiert haben, wählt eine Person ein Spiel und tippt auf „Raum erstellen“.\nAlle anderen treten über „Spiel beitreten“ bei – fertig!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tout le monde a installé l’app, une personne choisit un jeu et touche « Créer un salon ».\nLes autres rejoignent avec « Rejoindre une partie », et c’est tout !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo che tutti hanno installato l’app, una persona sceglie un gioco e tocca «Crea stanza».\nGli altri entrano con «Unisciti a una partita» e il gioco è fatto!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que todos instalarem o app, uma pessoa escolhe um jogo e toca em «Criar sala».\nOs outros entram em «Entrar em uma partida» e pronto!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อทุกคนติดตั้งแอปแล้ว ให้คนหนึ่งเลือกเกมแล้วกด “สร้างห้อง”\nคนอื่นกด “เข้าร่วมเกม” เพื่อเข้าห้องนั้น แค่นี้เอง!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi mọi người cài ứng dụng, một người chọn trò chơi rồi nhấn “Tạo phòng”.\nNhững người còn lại vào phòng bằng “Tham gia ván chơi” là xong!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až si všichni nainstalují aplikaci, jeden vybere hru a klepne na „Vytvořit místnost“.\nOstatní se přidají přes „Připojit se ke hře“ — hotovo!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når alle har installeret appen, vælger én et spil og trykker „Opret rum“.\nDe andre kommer ind med „Deltag i et spil“ — så er det klaret!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφού όλοι εγκαταστήσουν την εφαρμογή, ένας διαλέγει παιχνίδι και πατά «Δημιουργία δωματίου».\nΟι υπόλοιποι μπαίνουν με το «Συμμετοχή σε παιχνίδι» και έτοιμο!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kaikki ovat asentaneet sovelluksen, yksi valitsee pelin ja painaa ”Luo huone”.\nMuut liittyvät huoneeseen kohdasta ”Liity peliin” — siinä kaikki!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah semua memasang aplikasi, satu orang memilih permainan lalu menekan “Buat ruangan”.\nYang lain masuk lewat “Gabung permainan” — selesai!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når alle har installert appen, velger én et spill og trykker «Opprett rom».\nDe andre kommer inn med «Bli med i et spill» — så er det gjort!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als iedereen de app heeft geïnstalleerd, kiest één persoon een spel en tikt op ‘Kamer maken’.\nDe rest doet mee via ‘Meedoen aan een spel’ en klaar!"
          }
        }
      }
    },
    "가까이 모여 연결을 허용해 주세요" : {

    "버그 제보나 바라는 게임이 있다면 편하게 알려 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버그 제보나 바라는 게임이 있다면 편하게 알려 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel free to tell us about bugs or games you would like to see."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel free to tell us about bugs or games you would like to see."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグの報告や遊びたいゲームがあれば、気軽に教えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有bug反馈或想玩的游戏,欢迎随时告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有bug反饋或想玩的遊戲,歡迎隨時告訴我們。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщайте об ошибках или об играх, в которые хотели бы играть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si encuentras errores o quieres sugerir algún juego, cuéntanoslo sin problema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde gern Fehler oder Spiele, die du dir wünschst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’hésitez pas à signaler un bug ou un jeu que vous aimeriez voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala pure bug o giochi che vorresti vedere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiver um bug para relatar ou um jogo que gostaria de ver, é só avisar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าพบบั๊กหรืออยากให้มีเกมไหน บอกเราได้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu có lỗi cần báo hoặc trò chơi bạn muốn có, cứ thoải mái cho chúng tôi biết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej nám klidně vědět o chybě nebo o hře, kterou bys rád viděl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl os endelig om fejl eller spil, du gerne vil have."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες μας ελεύθερα για σφάλματα ή παιχνίδια που θα ήθελες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro rohkeasti virheistä tai peleistä, joita haluaisit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silakan beri tahu kami jika ada bug atau permainan yang kamu inginkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si gjerne fra om feil eller spill du ønsker deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het gerust weten bij bugs of spellen die je graag zou willen."
          }
        }
      }
    },

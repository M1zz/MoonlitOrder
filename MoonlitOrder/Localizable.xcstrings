    "밤사이 카드가 바뀌었을 수도 있습니다!\n토론으로 도깨비(현재 카드 기준)를 찾아내세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤사이 카드가 바뀌었을 수도 있습니다!\n토론으로 도깨비(현재 카드 기준)를 찾아내세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards may have changed overnight!\nFind the Goblin (by current card) through discussion."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards may have changed overnight!\nFind the Goblin (by current card) through discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜のあいだにカードが入れ替わったかもしれません!\n議論で鬼(現在のカード基準)を見つけ出しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里牌可能已经被换掉!\n请通过讨论找出鬼怪(以当前的牌为准)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜裡牌可能已經被換掉!\n請透過討論找出鬼怪(以當前的牌為準)。"
          }
        }
      }
    },

    "%@은(는) 잠시 점검 중이에요. 다른 게임을 골라 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 잠시 점검 중이에요. 다른 게임을 골라 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is down for maintenance. Please pick another game."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is down for maintenance. Please pick another game."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は少しメンテナンス中です。ほかのゲームを選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正在维护中。请选择其他游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正在維護中。請選擇其他遊戲。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра «%@» временно на обслуживании. Выберите другую игру."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está en mantenimiento. Elige otro juego."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird gerade gewartet. Bitte wähle ein anderes Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est en maintenance. Choisissez un autre jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è in manutenzione. Scegli un altro gioco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está em manutenção. Escolha outro jogo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” กำลังปิดปรับปรุง โปรดเลือกเกมอื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đang bảo trì. Hãy chọn trò chơi khác."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra „%@“ je v údržbě. Vyber jinou hru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ er under vedligeholdelse. Vælg et andet spil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» είναι υπό συντήρηση. Διάλεξε άλλο παιχνίδι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peli ”%@” on huollossa. Valitse toinen peli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sedang dalam perawatan. Pilih permainan lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» er under vedlikehold. Velg et annet spill."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is in onderhoud. Kies een ander spel."
          }
        }
      }
    },

    "도깨비가 추방되었습니다. 마을의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비가 추방되었습니다. 마을의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Goblin was banished. The Village wins!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Goblin was banished. The Village wins!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼が追放されました。村の勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪被放逐了。村庄获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼怪被放逐了。村莊獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гоблин изгнан. Деревня побеждает!"
          }

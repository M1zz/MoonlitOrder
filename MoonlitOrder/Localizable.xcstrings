    "현재 발언자의 차례를 끝내고 다음으로 넘깁니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 발언자의 차례를 끝내고 다음으로 넘깁니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ending the current speaker's turn and passing to the next."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ending the current speaker's turn and passing to the next."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の発言者の番を終えて、次の人に進めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

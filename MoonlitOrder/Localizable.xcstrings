    "당신은 그림자 단원이 누구인지 알고 있습니다. 하지만 정체가 드러나면 마지막에 암살당할 수 있으니, 티 내지 말고 은밀하게 원정대를 이끌어야 합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 그림자 단원이 누구인지 알고 있습니다. 하지만 정체가 드러나면 마지막에 암살당할 수 있으니, 티 내지 말고 은밀하게 원정대를 이끌어야 합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You know who the Shadow Agents are. But if you give yourself away, you can be assassinated at the end, so lead the teams discreetly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You know who the Shadow Agents are. But if you give yourself away, you can be assassinated at the end, so lead the teams discreetly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは影の団員が誰かを知っています。ただし正体がばれると最後に暗殺される恐れがあるので、気づかれないよう密かに遠征隊を導いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道谁是暗影成员。但身份一旦暴露,最后可能被刺杀,所以要不动声色地暗中带领远征队。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道誰是暗影成員。但身分一旦暴露,最後可能被刺殺,所以要不動聲色地暗中帶領遠征隊。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы знаете, кто из игроков — агенты теней. Но если выдадите себя, вас могут убить в конце, поэтому ведите отряды незаметно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabes quiénes son los agentes de las Sombras. Pero si te descubren, podrían asesinarte al final, así que guía a los equipos con discreción."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weißt, wer die Schattenagenten sind. Wirst du aber enttarnt, kannst du am Ende ermordet werden – führe die Teams also unauffällig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous savez qui sont les agents de l’Ombre. Mais si vous vous trahissez, vous pourriez être assassiné à la fin : guidez les équipes avec discrétion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai chi sono gli agenti delle Ombre. Ma se ti scoprono, alla fine potresti essere assassinato: guida i gruppi con discrezione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabe quem são os agentes das Sombras. Mas, se for descoberto, pode ser assassinado no final — então conduza as equipes com discrição."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณรู้ว่าใครคือสายลับเงามืด แต่ถ้าตัวตนถูกเปิดเผย คุณอาจถูกลอบสังหารตอนท้าย จงนำทีมอย่างเงียบ ๆ อย่าให้ใครสังเกต"
          }
        }
      }
    },
    "당신은 달빛 결사의 충직한 단원입니다. 토론과 투표 기록을 근거로 그림자 단원을 찾아내고, 미션 3회를 성공시키세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 달빛 결사의 충직한 단원입니다. 토론과 투표 기록을 근거로 그림자 단원을 찾아내고, 미션 3회를 성공시키세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a loyal member of the Moonlit Order. Use the discussion and voting record to uncover the Shadow Agents and make 3 missions succeed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a loyal member of the Moonlit Order. Use the discussion and voting record to uncover the Shadow Agents and make 3 missions succeed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは月光結社の忠実な一員です。議論と投票の記録を手がかりに影の団員を見つけ出し、ミッションを3回成功させましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是月光结社的忠诚成员。根据讨论和投票记录找出暗影成员,让任务成功3次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是月光結社的忠誠成員。根據討論和投票記錄找出暗影成員,讓任務成功3次。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы — верный член Лунного ордена. Опираясь на обсуждения и записи голосований, найдите агентов теней и добейтесь успеха в трёх миссиях."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres un miembro leal de la Orden Lunar. Usa el debate y el registro de votos para descubrir a los agentes de las Sombras y lograr 3 misiones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist ein treues Mitglied des Mondordens. Nutze Diskussion und Abstimmungsverlauf, um die Schattenagenten zu finden und 3 Missionen zu schaffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes un membre loyal de l’Ordre Lunaire. Appuyez-vous sur les discussions et l’historique des votes pour démasquer les agents de l’Ombre et réussir 3 missions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei un fedele membro dell’Ordine Lunare. Usa la discussione e lo storico dei voti per scovare gli agenti delle Ombre e portare a termine 3 missioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é um membro leal da Ordem Lunar. Use a discussão e o histórico de votos para descobrir os agentes das Sombras e fazer 3 missões darem certo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคือสมาชิกผู้ภักดีของภาคีแสงจันทร์ ใช้บันทึกการอภิปรายและการโหวตหาสายลับเงามืด แล้วทำภารกิจให้สำเร็จ 3 ครั้ง"
          }
        }
      }
    },
    "당신은 그림자의 칼끝입니다. 동료 그림자 단원들을 알고 있으며, 결사가 미션 3회를 성공하더라도 예언자를 정확히 지목하면 역전승합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 그림자의 칼끝입니다. 동료 그림자 단원들을 알고 있으며, 결사가 미션 3회를 성공하더라도 예언자를 정확히 지목하면 역전승합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the Shadows' blade. You know your fellow Shadow Agents, and even if the Order succeeds at 3 missions, you win if you correctly name the Seer."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the Shadows' blade. You know your fellow Shadow Agents, and even if the Order succeeds at 3 missions, you win if you correctly name the Seer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは影の刃です。仲間の影の団員を知っていて、結社がミッションを3回成功させても、予言者を正しく指名すれば逆転勝利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是暗影的刀锋。你认识同伴暗影成员,即使结社完成3次任务,只要准确指认预言家就能逆转获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是暗影的刀鋒。你認識同伴暗影成員,即使結社完成3次任務,只要準確指認預言家就能逆轉獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы — клинок Теней. Вы знаете других агентов теней, и даже если орден выполнит три миссии, вы победите, точно указав на пророка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres la daga de las Sombras. Conoces a tus compañeros y, aunque la Orden logre 3 misiones, ganas si señalas con acierto al Vidente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist die Klinge der Schatten. Du kennst die anderen Schattenagenten, und selbst wenn der Orden 3 Missionen schafft, gewinnst du, wenn du den Seher richtig benennst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes la lame des Ombres. Vous connaissez les autres agents et, même si l’Ordre réussit 3 missions, vous gagnez en désignant correctement l’Oracle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei la lama delle Ombre. Conosci gli altri agenti e, anche se l’Ordine compie 3 missioni, vinci se indichi correttamente il Veggente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é a lâmina das Sombras. Conhece os outros agentes e, mesmo que a Ordem cumpra 3 missões, vence se apontar corretamente o Vidente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคือคมดาบของเงามืด คุณรู้จักสายลับเงามืดคนอื่น และต่อให้ภาคีทำภารกิจสำเร็จ 3 ครั้ง คุณก็ชนะได้ถ้าชี้ตัวผู้ทำนายถูก"
          }
        }
      }
    },
    "당신은 어둠 속에 숨은 배신자입니다. 동료 그림자를 알고 있습니다. 정체를 숨기고 원정대에 잠입해 미션을 실패시키세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 어둠 속에 숨은 배신자입니다. 동료 그림자를 알고 있습니다. 정체를 숨기고 원정대에 잠입해 미션을 실패시키세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a traitor hiding in the dark. You know your fellow Shadows. Hide your identity, infiltrate the teams and make missions fail."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a traitor hiding in the dark. You know your fellow Shadows. Hide your identity, infiltrate the teams and make missions fail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは闇に潜む裏切り者です。仲間の影を知っています。正体を隠して遠征隊に紛れ込み、ミッションを失敗させましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是潜伏在黑暗中的叛徒。你认识同伴暗影。隐藏身份,混入远征队,让任务失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是潛伏在黑暗中的叛徒。你認識同伴暗影。隱藏身分,混入遠征隊,讓任務失敗。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы — предатель, скрывающийся во тьме. Вы знаете остальных Теней. Скройте свою личность, проникните в отряд и проваливайте миссии."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres un traidor oculto en la oscuridad. Conoces a las demás Sombras. Oculta tu identidad, infíltrate en los equipos y haz fracasar las misiones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist ein Verräter im Dunkeln. Du kennst die anderen Schatten. Verbirg deine Identität, schleich dich in die Teams ein und lass Missionen scheitern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes un traître tapi dans l’ombre. Vous connaissez vos complices. Cachez votre identité, infiltrez les équipes et faites échouer les missions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei un traditore nascosto nel buio. Conosci le altre Ombre. Nascondi la tua identità, infiltrati nei gruppi e fai fallire le missioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é um traidor escondido no escuro. Conhece as outras Sombras. Esconda sua identidade, infiltre-se nas equipes e faça as missões falharem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคือผู้ทรยศที่ซ่อนอยู่ในความมืด คุณรู้จักพวกเงามืดด้วยกัน ซ่อนตัวตน แทรกเข้าไปในทีม และทำให้ภารกิจล้มเหลว"
          }
        }
      }
    },
    "미션 3회 성공 (단, 예언자가 암살당하면 패배)" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 3회 성공 (단, 예언자가 암살당하면 패배)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

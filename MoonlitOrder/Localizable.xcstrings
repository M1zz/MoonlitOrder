    "화가 대신 제시어를 무작위로 골라 그리기를 시작합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화가 대신 제시어를 무작위로 골라 그리기를 시작합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picking a word at random for the Artist and starting the drawing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picking a word at random for the Artist and starting the drawing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵描きの代わりにお題をランダムに選んで、描き始めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替画家随机选出题词,开始作画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替畫家隨機選出題詞,開始作畫。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слово выбирается случайно вместо художника, и рисование начинается."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elige una palabra al azar en lugar del Artista y empieza el dibujo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt des Zeichners wird zufällig ein Wort gewählt und das Zeichnen beginnt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot est choisi au hasard à la place du Dessinateur et le dessin commence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al posto del Disegnatore viene scelta una parola a caso e il disegno inizia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma palavra é escolhida ao acaso no lugar do Artista e o desenho começa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุ่มเลือกคำแทนผู้วาดแล้วเริ่มวาด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngẫu nhiên một từ thay cho Họa sĩ và bắt đầu vẽ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo malíře se náhodně vybere slovo a začíná kreslení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ord vælges tilfældigt i stedet for tegneren, og tegningen går i gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέγεται τυχαία μια λέξη αντί για τον Ζωγράφο και ξεκινά το σχέδιο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtäjän puolesta valitaan satunnainen sana ja piirtäminen alkaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata dipilih acak menggantikan Pelukis, lalu menggambar dimulai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ord velges tilfeldig i stedet for tegneren, og tegningen starter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In plaats van de Tekenaar wordt willekeurig een woord gekozen en het tekenen begint."
          }
        }
      }
    },

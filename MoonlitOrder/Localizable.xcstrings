      }
    },
    "도깨비는 모두 중앙에 있었고, 아무도 추방되지 않았습니다. 마을의 승리!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비는 모두 중앙에 있었고, 아무도 추방되지 않았습니다. 마을의 승리!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the Goblins were in the center, and nobody was banished. The Village wins!"

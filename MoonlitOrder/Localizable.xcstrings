    "미션 3회 실패 · 원정대 5회 연속 부결 · 예언자 암살 성공 — 셋 중 하나면 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 3회 실패 · 원정대 5회 연속 부결 · 예언자 암살 성공 — 셋 중 하나면 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missions fail · 5 teams in a row rejected · the Seer is assassinated. Any one of the three wins."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missions fail · 5 teams in a row rejected · the Seer is assassinated. Any one of the three wins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッション3回失敗 ・ 遠征隊5回連続否決 ・ 予言者の暗殺成功 — この3つのうちどれかで勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务失败3次 · 远征队连续5次被否决 · 刺杀预言家成功 — 三者满足其一即获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任務失敗3次 · 遠征隊連續5次被否決 · 刺殺預言家成功 — 三者滿足其一即獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 проваленные миссии · 5 отклонённых отрядов подряд · успешное убийство пророка — достаточно любого из трёх."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 misiones fallidas · 5 equipos rechazados seguidos · asesinato del Vidente — con cualquiera de las tres ganas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 Missionen scheitern · 5 abgelehnte Teams in Folge · Mord am Seher gelingt — eines von dreien genügt zum Sieg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missions échouées · 5 équipes rejetées d’affilée · assassinat de l’Oracle réussi — l’un des trois suffit pour gagner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missioni fallite · 5 gruppi respinti di fila · assassinio del Veggente riuscito — ne basta una per vincere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missões fracassadas · 5 equipes rejeitadas seguidas · assassinato do Vidente — qualquer uma das três dá a vitória."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภารกิจล้มเหลว 3 ครั้ง · ทีมถูกปฏิเสธติดกัน 5 ครั้ง · ลอบสังหารผู้ทำนายสำเร็จ — ข้อใดข้อหนึ่งก็ชนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 nhiệm vụ thất bại · 5 đội bị từ chối liên tiếp · ám sát Nhà Tiên Tri thành công — chỉ cần một trong ba là thắng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 neúspěšné mise · 5 zamítnutých týmů po sobě · úspěšná vražda Věštce — stačí kterákoli z tří."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 mislykkede missioner · 5 afviste hold i træk · vellykket mord på Seeren — én af de tre er nok til at vinde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 αποτυχημένες αποστολές · 5 απορρίψεις ομάδας στη σειρά · επιτυχημένη δολοφονία του Μάντη — κερδίζεις με οποιοδήποτε από τα τρία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 tehtävää epäonnistuu · 5 ryhmää hylätään peräkkäin · Näkijän murha onnistuu — mikä tahansa kolmesta riittää voittoon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 misi gagal · 5 tim ditolak berturut-turut · pembunuhan Peramal berhasil — salah satu dari tiga sudah cukup untuk menang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 mislykkede oppdrag · 5 avviste lag på rad · vellykket mord på Seeren — ett av de tre er nok til å vinne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 missies mislukken · 5 teams achter elkaar afgewezen · moord op de Ziener lukt — één van de drie is genoeg om te winnen."
          }
        }
      }
    },
    "투표로 라이어를 정확히 지목하고, 라이어가 제시어 추측에 실패하면 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투표로 라이어를 정확히 지목하고, 라이어가 제시어 추측에 실패하면 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the vote correctly names the Liar and the Liar then fails to guess the word."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the vote correctly names the Liar and the Liar then fails to guess the word."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票でライアーを正しく指名し、ライアーがお題の推測に失敗すれば勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过投票准确指认说谎者,且说谎者没能猜中题词,即获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過投票準確指認說謊者,且說謊者沒能猜中題詞,即獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если голосованием точно указали на лжеца, а он не угадал слово."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si la votación señala con acierto al Mentiroso y este no adivina la palabra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn die Abstimmung den Lügner richtig benennt und der Lügner das Wort nicht errät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gagnez si le vote désigne correctement le Menteur et que celui-ci ne devine pas le mot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinci se la votazione indica correttamente il Bugiardo e lui non indovina la parola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vence se a votação apontar corretamente o Mentiroso e ele não acertar a palavra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชนะถ้าการโหวตชี้ตัวไลเออร์ได้ถูกต้อง และไลเออร์ทายคำไม่ถูก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thắng nếu cuộc bỏ phiếu chỉ đúng Kẻ Nói Dối và Kẻ Nói Dối không đoán được từ khóa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhráváš, pokud hlasování správně určí Lháře a ten slovo neuhodne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinder, hvis afstemningen udpeger Løgneren rigtigt, og Løgneren ikke gætter ordet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κερδίζεις αν η ψηφοφορία υποδείξει σωστά τον Ψεύτη και ο Ψεύτης δεν μαντέψει τη λέξη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voitat, jos äänestys osoittaa Valehtelijan oikein eikä Valehtelija arvaa sanaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menang jika pemungutan suara menunjuk Si Pembohong dengan tepat dan Si Pembohong gagal menebak kata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinner hvis avstemningen peker ut Løgneren riktig og Løgneren ikke gjetter ordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wint als de stemming de Leugenaar juist aanwijst en de Leugenaar het woord niet raadt."
          }
        }
      }
    },
    "표가 갈리거나 엉뚱한 사람이 지목되면 승리. 잡히더라도 제시어를 맞히면 역전승!" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표가 갈리거나 엉뚱한 사람이 지목되면 승리. 잡히더라도 제시어를 맞히면 역전승!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the votes are split or the wrong person is accused. Even if caught, guessing the word turns the game around!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if the votes are split or the wrong person is accused. Even if caught, guessing the word turns the game around!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票が割れる、または違う人が指名されたら勝利。捕まっても、お題を当てれば逆転勝利!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票数分散或指认错人即获胜。即使被抓,猜中题词也能逆转获胜!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票數分散或指認錯人即獲勝。即使被抓,猜中題詞也能逆轉獲勝!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если голоса разделились или указали не на того. Даже если лжеца поймали, он побеждает, если угадает слово!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si los votos se dividen o se señala a la persona equivocada. Aunque lo atrapen, si adivina la palabra remonta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn die Stimmen geteilt sind oder die falsche Person beschuldigt wird. Selbst wenn der Lügner gefasst wird, dreht er das Spiel, wenn er das Wort errät!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gagnez si les voix se partagent ou si la mauvaise personne est désignée. Même démasqué, le Menteur renverse la partie s’il devine le mot !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinci se i voti si dividono o viene accusata la persona sbagliata. Anche se scoperto, il Bugiardo ribalta la partita se indovina la parola!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vence se os votos se dividirem ou a pessoa errada for acusada. Mesmo se pego, o Mentiroso vira o jogo ao acertar a palavra!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชนะถ้าคะแนนโหวตแตกกันหรือชี้ผิดคน ต่อให้ถูกจับได้ ถ้าทายคำถูกก็พลิกชนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thắng nếu phiếu bị chia đều hoặc chỉ nhầm người. Dù bị bắt, Kẻ Nói Dối vẫn lật ngược thế cờ nếu đoán đúng từ khóa!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhráváš, pokud se hlasy rozdělí nebo je označen špatný člověk. I když je Lhář chycen, otočí hru, pokud slovo uhodne!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinder, hvis stemmerne deles, eller den forkerte udpeges. Selv hvis Løgneren fanges, vender han spillet ved at gætte ordet!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κερδίζεις αν οι ψήφοι μοιραστούν ή υποδειχθεί λάθος άνθρωπος. Ακόμη κι αν πιαστεί, ο Ψεύτης ανατρέπει το παιχνίδι αν μαντέψει τη λέξη!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voitat, jos äänet jakautuvat tai osoitetaan väärää henkilöä. Vaikka Valehtelija jäisi kiinni, hän kääntää pelin arvaamalla sanan!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menang jika suara terbagi atau orang yang salah ditunjuk. Meski tertangkap, Si Pembohong membalikkan keadaan jika menebak kata!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vinner hvis stemmene deles eller feil person pekes ut. Selv om Løgneren blir tatt, snur han spillet ved å gjette ordet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wint als de stemmen verdeeld zijn of de verkeerde persoon wordt aangewezen. Zelfs als de Leugenaar gepakt wordt, keert hij het spel door het woord te raden!"
          }
        }
      }
    },

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να παίζεις και με φίλους από το εξωτερικό, η εφαρμογή χρησιμοποιείται και στα αγγλικά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotta voit pelata myös ulkomaisten kavereiden kanssa, sovellusta voi käyttää englanniksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

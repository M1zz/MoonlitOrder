            "state" : "translated",
            "value" : "ミッション3回成功(ただし予言者が暗殺されると敗北)"
          }
        }
      }
    },
    "미션 3회 실패 · 원정대 5회 연속 부결 · 예언자 암살" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {

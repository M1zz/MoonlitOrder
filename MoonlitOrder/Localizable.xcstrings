    "동료 도깨비를 확인합니다. 당신이 유일한 도깨비라면 중앙 카드 1장을 볼 수 있습니다. 날이 밝으면 사람인 척 정체를 숨기세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동료 도깨비를 확인합니다. 당신이 유일한 도깨비라면 중앙 카드 1장을 볼 수 있습니다. 날이 밝으면 사람인 척 정체를 숨기세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet your fellow Goblins. If you are the only Goblin, you may look at 1 center card. When day breaks, hide your identity and act human."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet your fellow Goblins. If you are the only Goblin, you may look at 1 centre card. When day breaks, hide your identity and act human."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仲間の鬼を確認します。鬼があなた一人なら、中央のカードを1枚見られます。夜が明けたら、人間のふりをして正体を隠しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认同伴鬼怪。如果你是唯一的鬼怪,可以查看1张中间的牌。天亮后要假装是普通人,隐藏身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認同伴鬼怪。如果你是唯一的鬼怪,可以檢視1張中間的牌。天亮後要假裝是普通人,隱藏身分。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы узнаёте других гоблинов. Если вы единственный гоблин, можете посмотреть 1 центральную карту. Когда рассветёт, скрывайте свою сущность и притворяйтесь человеком."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconoces a tus compañeros Trasgos. Si eres el único Trasgo, puedes mirar 1 carta central. Cuando amanezca, oculta tu identidad y haz como que eres humano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erkennst deine Mit-Kobolde. Bist du der einzige Kobold, darfst du 1 mittlere Karte ansehen. Wenn es hell wird, verbirg deine Identität und tu so, als wärst du ein Mensch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous découvrez vos camarades Gobelins. Si vous êtes le seul Gobelin, vous pouvez regarder 1 carte centrale. Au lever du jour, cachez votre identité et faites comme si vous étiez humain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri i tuoi compagni Goblin. Se sei l’unico Goblin, puoi guardare 1 carta centrale. All’alba, nascondi la tua identità e fingi di essere umano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você reconhece seus companheiros Goblins. Se for o único Goblin, pode olhar 1 carta central. Quando amanhecer, esconda sua identidade e finja ser humano."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูว่าใครคือก็อบลินพวกเดียวกัน ถ้าคุณเป็นก็อบลินคนเดียว จะดูการ์ดกลางได้ 1 ใบ เมื่อฟ้าสาง ให้ซ่อนตัวตนและทำเป็นคนธรรมดา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn biết các Yêu tinh đồng đội. Nếu bạn là Yêu tinh duy nhất, bạn được xem 1 lá bài giữa. Khi trời sáng, hãy giấu danh tính và giả làm người thường."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznáš ostatní skřety. Pokud jsi jediný skřet, můžeš se podívat na 1 prostřední kartu. Až se rozední, skryj totožnost a tvař se jako člověk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kender dine goblin-kammerater. Er du den eneste goblin, må du kigge på 1 midterkort. Når det bliver dag, skal du skjule din identitet og lade som om, du er menneske."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βλέπεις τους συντρόφους σου Καλλικαντζάρους. Αν είσαι ο μόνος Καλλικάντζαρος, μπορείς να δεις 1 κεντρική κάρτα. Όταν ξημερώσει, κρύψε την ταυτότητά σου και παρίστανε τον άνθρωπο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnet toverisi menninkäiset. Jos olet ainoa menninkäinen, saat katsoa 1 keskikorttia. Kun päivä sarastaa, piilota henkilöllisyytesi ja esitä ihmistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mengenali sesama Goblin. Jika kamu satu-satunya Goblin, kamu boleh melihat 1 kartu tengah. Saat fajar menyingsing, sembunyikan identitasmu dan berpura-puralah jadi manusia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kjenner dine goblin-kamerater. Er du den eneste goblinen, kan du se på 1 midtkort. Når dagen gryr, skjuler du identiteten din og later som om du er et menneske."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet je mede-goblins. Ben je de enige goblin, dan mag je 1 middenkaart bekijken. Als het licht wordt, verberg je je identiteit en doe je alsof je een mens bent."
          }
        }
      }
    },
    "신통력으로 다른 플레이어 1명의 카드 또는 중앙 카드 2장을 볼 수 있습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신통력으로 다른 플레이어 1명의 카드 또는 중앙 카드 2장을 볼 수 있습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your supernatural sight, look at 1 other player's card or the 2 center cards."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your supernatural sight, look at 1 other player's card or the 2 centre cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不思議な力で、ほかのプレイヤー1人のカード、または中央のカード2枚を見られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凭借神通,可以查看1名其他玩家的牌,或查看中间的2张牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

    "원정대 구성이 %lld회 연속 부결되어 그림자 진영이 승리했습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원정대 구성이 %lld회 연속 부결되어 그림자 진영이 승리했습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The team was rejected %lld times in a row. The Shadows win."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The team was rejected %lld times in a row. The Shadows win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊の編成が%lld回連続で否決され、影陣営が勝利しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远征队连续%lld次被否决,暗影阵营获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠征隊連續%lld次被否決,暗影陣營獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состав отряда отклонён %lld раз подряд, и побеждают Тени."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equipo fue rechazado %lld veces seguidas y las Sombras ganan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Team wurde %lld-mal in Folge abgelehnt. Die Schatten gewinnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’équipe a été rejetée %lld fois de suite. Les Ombres l’emportent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gruppo è stato respinto %lld volte di fila. Vincono le Ombre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A equipe foi rejeitada %lld vezes seguidas. As Sombras vencem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีมถูกปฏิเสธติดกัน %lld ครั้ง ฝ่ายเงามืดชนะ"
          }
        }
      }
    },
    "미션이 3회 실패하여 그림자 진영이 승리했습니다." : {

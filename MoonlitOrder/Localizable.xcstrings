    "도깨비(최종 카드 기준)를 추방하면 승리. 도깨비가 모두 중앙 카드에 있다면, 아무도 추방하지 않아야 승리." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비(최종 카드 기준)를 추방하면 승리. 도깨비가 모두 중앙 카드에 있다면, 아무도 추방하지 않아야 승리."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win by banishing a Goblin (by final card). If every Goblin is among the center cards, you win only if nobody is banished."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win by banishing a Goblin (by final card). If every Goblin is among the centre cards, you win only if nobody is banished."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼(最終カード基準)を追放すれば勝利。鬼がすべて中央のカードにある場合は、誰も追放しなければ勝利。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放逐鬼怪(以最终的牌为准)即获胜。如果鬼怪全都在中间的牌里,则不放逐任何人才算获胜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放逐鬼怪(以最終的牌為準)即獲勝。如果鬼怪全都在中間的牌裡,則不放逐任何人才算獲勝。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, изгнав гоблина (по финальной карте). Если все гоблины в центре, вы побеждаете, только если никого не изгнали."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si expulsas a un Trasgo (según la carta final). Si todos los Trasgos están entre las cartas centrales, ganas solo si no se expulsa a nadie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn ein Kobold (nach letzter Karte) verbannt wird. Liegen alle Kobolde in der Mitte, gewinnst du nur, wenn niemand verbannt wird."
          }
        }
      }
    },
    "도깨비가 한 명도 추방되지 않으면 승리 — 애꿎은 사람이 추방돼도 이겨요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도깨비가 한 명도 추방되지 않으면 승리 — 애꿎은 사람이 추방돼도 이겨요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if no Goblin is banished. You win even if an innocent player is banished."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win if no Goblin is banished. You win even if an innocent player is banished."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬼が一人も追放されなければ勝利 — 無実の人が追放されても勝ちです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要没有鬼怪被放逐就获胜 — 即使无辜的人被放逐也算赢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要沒有鬼怪被放逐就獲勝 — 即使無辜的人被放逐也算贏。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы побеждаете, если ни один гоблин не изгнан — даже если изгнали невиновного."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas si no se expulsa a ningún Trasgo — ganas incluso si expulsan a un inocente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst, wenn kein Kobold verbannt wird — auch wenn ein Unschuldiger verbannt wird."
          }
        }
      }
    },
